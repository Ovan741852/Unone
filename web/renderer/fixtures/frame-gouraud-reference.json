{
  "profile": "rgb8_encoded_gouraud_v1",
  "clip_xy": [[-1,-1],[3,-1],[-1,3]],
  "rgba": [[1,0,0,0.25],[0,1,0,0.75],[0,0,1,1]],
  "initial_rgb8": [20,40,60],
  "cases": ["rgb-alpha-gradient","alpha-test","blend-over","blend-add"],
  "samples": "four physical corners and four quarter points, eight samples per case",
  "weights": "u=(x+0.5)/(2*width);v=(height-y-0.5)/(2*height);w=1-u-v",
  "alpha": "0.25*w+0.75*u+v",
  "alpha_test": "alpha>0.55",
  "store": "RGBA8 encoded RGB, round(clamp01(rgb)*255)",
  "tolerance_rgb8": 1,
  "fixed_1280_720_rgb_first_four": [[128,0,127],[0,127,127],[255,0,0],[127,127,0]]
}
