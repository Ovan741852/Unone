{
  "$comment": "Generated from Rust deserialization types by game schema. Do not edit. Runtime semantic validators additionally check ranges, references, formats and capabilities.",
  "$defs": {
    "AnimationAssertion": {
      "additionalProperties": false,
      "description": "Full equality against one entity's published animation state.",
      "properties": {
        "entity": {
          "type": "string"
        },
        "equals": true
      },
      "required": [
        "entity",
        "equals"
      ],
      "type": "object"
    },
    "AudioAssertion": {
      "additionalProperties": false,
      "description": "Full equality against what the game asked to be heard.\n\n`events` is what was fired on the asserted frame; `loops` is what should\nstill be playing. They are separate because a test usually cares about one\nor the other: \"the reel stopped and made a noise\" is an event, \"the music\nsurvived the win screen\" is a loop.",
      "properties": {
        "events": {
          "default": null
        },
        "loops": {
          "default": null
        }
      },
      "type": "object"
    },
    "EffectsAssertion": {
      "additionalProperties": false,
      "description": "Full equality against the live effect list a host would be playing.",
      "properties": {
        "equals": true
      },
      "required": [
        "equals"
      ],
      "type": "object"
    },
    "InputFrame": {
      "additionalProperties": false,
      "properties": {
        "actions": {
          "additionalProperties": {
            "type": "boolean"
          },
          "default": {},
          "type": "object"
        },
        "physical": {
          "$ref": "#/$defs/PhysicalBatch"
        },
        "pointer": {
          "anyOf": [
            {
              "$ref": "#/$defs/PointerInput"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "ui_sliders": {
          "additionalProperties": {
            "$ref": "#/$defs/SliderInteraction"
          },
          "description": "Host-projected semantic slider events, consumed once per successful tick.\nValues/ranges remain in the official Luau control, not platform adapters.",
          "type": "object"
        },
        "ui_text_inputs": {
          "additionalProperties": {
            "$ref": "#/$defs/TextInputInteraction"
          },
          "description": "Host-owned UTF-8 editing snapshots, one event per ID per successful tick.",
          "type": "object"
        }
      },
      "type": "object"
    },
    "Modifiers": {
      "additionalProperties": false,
      "properties": {
        "alt": {
          "type": "boolean"
        },
        "alt_graph": {
          "type": "boolean"
        },
        "caps_lock": {
          "type": "boolean"
        },
        "control": {
          "type": "boolean"
        },
        "meta": {
          "type": "boolean"
        },
        "num_lock": {
          "type": "boolean"
        },
        "shift": {
          "type": "boolean"
        }
      },
      "required": [
        "shift",
        "control",
        "alt",
        "meta"
      ],
      "type": "object"
    },
    "ObservationAssertion": {
      "additionalProperties": false,
      "properties": {
        "equals": true,
        "key": {
          "type": "string"
        }
      },
      "required": [
        "key",
        "equals"
      ],
      "type": "object"
    },
    "PhysicalBatch": {
      "additionalProperties": false,
      "properties": {
        "after_sequence": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "epoch": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "events": {
          "items": {
            "$ref": "#/$defs/PhysicalEvent"
          },
          "type": "array"
        },
        "profile": {
          "type": "string"
        },
        "through_sequence": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "profile",
        "epoch",
        "after_sequence",
        "through_sequence",
        "events"
      ],
      "type": "object"
    },
    "PhysicalEvent": {
      "oneOf": [
        {
          "properties": {
            "code": {
              "type": "string"
            },
            "is_composing": {
              "type": "boolean"
            },
            "kind": {
              "const": "key",
              "type": "string"
            },
            "location": {
              "format": "uint8",
              "maximum": 255,
              "minimum": 0,
              "type": "integer"
            },
            "modifiers": {
              "$ref": "#/$defs/Modifiers"
            },
            "repeat": {
              "type": "boolean"
            },
            "state": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "code",
            "location",
            "state",
            "repeat",
            "is_composing",
            "modifiers"
          ],
          "type": "object"
        },
        {
          "properties": {
            "button": {
              "format": "int8",
              "maximum": 127,
              "minimum": -128,
              "type": "integer"
            },
            "buttons": {
              "format": "uint8",
              "maximum": 255,
              "minimum": 0,
              "type": "integer"
            },
            "kind": {
              "const": "pointer",
              "type": "string"
            },
            "modifiers": {
              "$ref": "#/$defs/Modifiers"
            },
            "phase": {
              "type": "string"
            },
            "point": {
              "$ref": "#/$defs/Point"
            },
            "pointer_id": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "pointer_type": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "pointer_id",
            "pointer_type",
            "phase",
            "button",
            "buttons",
            "modifiers"
          ],
          "type": "object"
        },
        {
          "properties": {
            "delta_x": {
              "format": "double",
              "type": "number"
            },
            "delta_y": {
              "format": "double",
              "type": "number"
            },
            "delta_z": {
              "format": "double",
              "type": "number"
            },
            "kind": {
              "const": "wheel",
              "type": "string"
            },
            "modifiers": {
              "$ref": "#/$defs/Modifiers"
            },
            "point": {
              "$ref": "#/$defs/Point"
            },
            "unit": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "delta_x",
            "delta_y",
            "delta_z",
            "unit",
            "point",
            "modifiers"
          ],
          "type": "object"
        },
        {
          "properties": {
            "captured": {
              "type": "boolean"
            },
            "kind": {
              "const": "capture",
              "type": "string"
            },
            "pointer_id": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "source": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "pointer_id",
            "captured",
            "source"
          ],
          "type": "object"
        },
        {
          "properties": {
            "focused": {
              "type": "boolean"
            },
            "kind": {
              "const": "focus",
              "type": "string"
            },
            "scope": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "focused",
            "scope"
          ],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "const": "reset",
              "type": "string"
            },
            "pointer_id": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "reason": {
              "type": "string"
            },
            "scope": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "scope",
            "reason"
          ],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "const": "viewport",
              "type": "string"
            },
            "viewport": {
              "$ref": "#/$defs/Viewport"
            }
          },
          "required": [
            "kind",
            "viewport"
          ],
          "type": "object"
        }
      ],
      "properties": {
        "origin": {
          "type": "string"
        },
        "received_us": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "route": {
          "type": "string"
        },
        "sequence": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "sequence",
        "received_us",
        "origin",
        "route"
      ],
      "type": "object",
      "unevaluatedProperties": false
    },
    "Point": {
      "additionalProperties": false,
      "properties": {
        "inside": {
          "type": "boolean"
        },
        "viewport": {
          "$ref": "#/$defs/Viewport"
        },
        "x": {
          "format": "double",
          "type": "number"
        },
        "y": {
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y",
        "inside",
        "viewport"
      ],
      "type": "object"
    },
    "PointerInput": {
      "additionalProperties": false,
      "properties": {
        "down": {
          "default": false,
          "type": "boolean"
        },
        "position": {
          "$ref": "#/$defs/Vec2"
        },
        "screen_position": {
          "anyOf": [
            {
              "$ref": "#/$defs/Vec2"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Host-normalized logical UI coordinates. When omitted, world position\nis used as a compatibility-free default for headless callers."
        }
      },
      "required": [
        "position"
      ],
      "type": "object"
    },
    "SliderInteraction": {
      "additionalProperties": false,
      "properties": {
        "phase": {
          "$ref": "#/$defs/SliderPhase"
        },
        "ratio": {
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "phase",
        "ratio"
      ],
      "type": "object"
    },
    "SliderPhase": {
      "enum": [
        "start",
        "drag",
        "end",
        "cancel"
      ],
      "type": "string"
    },
    "TestAssertion": {
      "additionalProperties": false,
      "properties": {
        "animation": {
          "anyOf": [
            {
              "$ref": "#/$defs/AnimationAssertion"
            },
            {
              "type": "null"
            }
          ]
        },
        "audio": {
          "anyOf": [
            {
              "$ref": "#/$defs/AudioAssertion"
            },
            {
              "type": "null"
            }
          ]
        },
        "effects": {
          "anyOf": [
            {
              "$ref": "#/$defs/EffectsAssertion"
            },
            {
              "type": "null"
            }
          ]
        },
        "entity": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "equals": {
          "default": null,
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "field": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "greater_than": {
          "default": null,
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "less_than": {
          "default": null,
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "observation": {
          "anyOf": [
            {
              "$ref": "#/$defs/ObservationAssertion"
            },
            {
              "type": "null"
            }
          ]
        },
        "ui": {
          "anyOf": [
            {
              "$ref": "#/$defs/UiAssertion"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "type": "object"
    },
    "TextInputInteraction": {
      "additionalProperties": false,
      "properties": {
        "composing": {
          "type": "boolean"
        },
        "phase": {
          "$ref": "#/$defs/TextInputPhase"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "phase",
        "text",
        "composing"
      ],
      "type": "object"
    },
    "TextInputPhase": {
      "enum": [
        "change",
        "submit",
        "cancel",
        "focus",
        "blur"
      ],
      "type": "string"
    },
    "UiAssertion": {
      "additionalProperties": false,
      "properties": {
        "equals": true
      },
      "required": [
        "equals"
      ],
      "type": "object"
    },
    "Vec2": {
      "additionalProperties": false,
      "properties": {
        "x": {
          "format": "double",
          "type": "number"
        },
        "y": {
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "type": "object"
    },
    "Viewport": {
      "additionalProperties": false,
      "properties": {
        "css_height": {
          "format": "double",
          "type": "number"
        },
        "css_width": {
          "format": "double",
          "type": "number"
        },
        "device_pixel_ratio": {
          "format": "double",
          "type": "number"
        },
        "height": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "rect_left": {
          "format": "double",
          "type": "number"
        },
        "rect_top": {
          "format": "double",
          "type": "number"
        },
        "revision": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "width": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "revision",
        "width",
        "height",
        "rect_left",
        "rect_top",
        "css_width",
        "css_height",
        "device_pixel_ratio"
      ],
      "type": "object"
    }
  },
  "$id": "https://unone.dev/schema/test.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One test case, one file.\n\nUnknown keys are rejected: a test file with a misspelled or invented key\nused to load with that key ignored, so a file whose assertions lived under\nthe wrong name passed green while checking nothing.",
  "properties": {
    "assertions": {
      "items": {
        "$ref": "#/$defs/TestAssertion"
      },
      "type": "array"
    },
    "frames": {
      "default": 60,
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "input": {
      "additionalProperties": {
        "type": "boolean"
      },
      "default": {},
      "type": "object"
    },
    "input_sequence": {
      "default": [],
      "items": {
        "$ref": "#/$defs/InputFrame"
      },
      "type": "array"
    },
    "load_save": {
      "default": null
    },
    "name": {
      "type": "string"
    },
    "seed": {
      "default": 42,
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "name"
  ],
  "title": "TestSpec",
  "type": "object"
}
