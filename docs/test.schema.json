{
  "$comment": "Generated from Rust deserialization types by game schema. Do not edit. Runtime semantic validators additionally check ranges, references, formats and capabilities.",
  "$defs": {
    "AnimationAssertion": {
      "additionalProperties": false,
      "description": "Full equality against one entity's published animation state.",
      "properties": {
        "entity": {
          "type": "string"
        },
        "equals": true
      },
      "required": [
        "entity",
        "equals"
      ],
      "type": "object"
    },
    "AudioAssertion": {
      "additionalProperties": false,
      "description": "Full equality against what the game asked to be heard.\n\n`events` is what was fired on the asserted frame; `loops` is what should\nstill be playing. They are separate because a test usually cares about one\nor the other: \"the reel stopped and made a noise\" is an event, \"the music\nsurvived the win screen\" is a loop.",
      "properties": {
        "events": {
          "default": null
        },
        "loops": {
          "default": null
        }
      },
      "type": "object"
    },
    "EffectsAssertion": {
      "additionalProperties": false,
      "description": "Full equality against the live effect list a host would be playing.",
      "properties": {
        "equals": true
      },
      "required": [
        "equals"
      ],
      "type": "object"
    },
    "InputFrame": {
      "additionalProperties": false,
      "properties": {
        "actions": {
          "additionalProperties": {
            "type": "boolean"
          },
          "default": {},
          "type": "object"
        },
        "pointer": {
          "anyOf": [
            {
              "$ref": "#/$defs/PointerInput"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "ui_sliders": {
          "additionalProperties": {
            "$ref": "#/$defs/SliderInteraction"
          },
          "description": "Host-projected semantic slider events, consumed once per successful tick.\nValues/ranges remain in the official Luau control, not platform adapters.",
          "type": "object"
        }
      },
      "type": "object"
    },
    "ObservationAssertion": {
      "additionalProperties": false,
      "properties": {
        "equals": true,
        "key": {
          "type": "string"
        }
      },
      "required": [
        "key",
        "equals"
      ],
      "type": "object"
    },
    "PointerInput": {
      "additionalProperties": false,
      "properties": {
        "down": {
          "default": false,
          "type": "boolean"
        },
        "position": {
          "$ref": "#/$defs/Vec2"
        },
        "screen_position": {
          "anyOf": [
            {
              "$ref": "#/$defs/Vec2"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Host-normalized logical UI coordinates. When omitted, world position\nis used as a compatibility-free default for headless callers."
        }
      },
      "required": [
        "position"
      ],
      "type": "object"
    },
    "SliderInteraction": {
      "additionalProperties": false,
      "properties": {
        "phase": {
          "$ref": "#/$defs/SliderPhase"
        },
        "ratio": {
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "phase",
        "ratio"
      ],
      "type": "object"
    },
    "SliderPhase": {
      "enum": [
        "start",
        "drag",
        "end",
        "cancel"
      ],
      "type": "string"
    },
    "TestAssertion": {
      "additionalProperties": false,
      "properties": {
        "animation": {
          "anyOf": [
            {
              "$ref": "#/$defs/AnimationAssertion"
            },
            {
              "type": "null"
            }
          ]
        },
        "audio": {
          "anyOf": [
            {
              "$ref": "#/$defs/AudioAssertion"
            },
            {
              "type": "null"
            }
          ]
        },
        "effects": {
          "anyOf": [
            {
              "$ref": "#/$defs/EffectsAssertion"
            },
            {
              "type": "null"
            }
          ]
        },
        "entity": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "equals": {
          "default": null,
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "field": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "greater_than": {
          "default": null,
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "less_than": {
          "default": null,
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "observation": {
          "anyOf": [
            {
              "$ref": "#/$defs/ObservationAssertion"
            },
            {
              "type": "null"
            }
          ]
        },
        "ui": {
          "anyOf": [
            {
              "$ref": "#/$defs/UiAssertion"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "type": "object"
    },
    "UiAssertion": {
      "additionalProperties": false,
      "properties": {
        "equals": true
      },
      "required": [
        "equals"
      ],
      "type": "object"
    },
    "Vec2": {
      "additionalProperties": false,
      "properties": {
        "x": {
          "format": "double",
          "type": "number"
        },
        "y": {
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "type": "object"
    }
  },
  "$id": "https://unone.dev/schema/test.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One test case, one file.\n\nUnknown keys are rejected: a test file with a misspelled or invented key\nused to load with that key ignored, so a file whose assertions lived under\nthe wrong name passed green while checking nothing.",
  "properties": {
    "assertions": {
      "items": {
        "$ref": "#/$defs/TestAssertion"
      },
      "type": "array"
    },
    "frames": {
      "default": 60,
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "input": {
      "additionalProperties": {
        "type": "boolean"
      },
      "default": {},
      "type": "object"
    },
    "input_sequence": {
      "default": [],
      "items": {
        "$ref": "#/$defs/InputFrame"
      },
      "type": "array"
    },
    "load_save": {
      "default": null
    },
    "name": {
      "type": "string"
    },
    "seed": {
      "default": 42,
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "name"
  ],
  "title": "TestSpec",
  "type": "object"
}
