    "Physics3DScene": {
      "additionalProperties": false,
      "properties": {
        "bodies": {
          "additionalProperties": {
            "$ref": "#/$defs/Body3D"
          },
          "default": {},
          "type": "object"
        },
        "gravity": {
          "$ref": "#/$defs/Vec3",
          "default": {
            "x": 0.0,
            "y": -9.81,
            "z": 0.0
          }
        }
      },
      "type": "object"
    },
    "PhysicsSettings": {
      "additionalProperties": false,
      "properties": {
        "gravity": {
          "$ref": "#/$defs/Vec2",
          "default": {
            "x": 0.0,
            "y": -9.8
          }
        },
        "ground_friction": {
          "default": 0.0,
          "description": "Horizontal velocity lost per second while a body rests on the ground.\n\nWithout it a landed body slides the length of the level, which silently\nturns a miss into a hit.",
          "format": "double",
          "type": "number"
        },
        "ground_y": {
          "default": null,
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "linear_damping": {
          "default": 0.0,
          "description": "Velocity lost per second by every dynamic body, as a fraction.\n\nDefaults to none, which is what this engine simulated before the field\nexisted: a body keeps its velocity forever unless something takes it.",
          "format": "double",
          "type": "number"
        }
      },
      "type": "object"
    },
    "ProjectConfig": {
      "additionalProperties": false,
      "properties": {
        "asset_manifest": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "audio": {
          "anyOf": [
            {
              "$ref": "#/$defs/AudioConfig"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Sound categories and the rules between them.\n\nUndeclared means no rules, not no sound: a game can still play and loop\nwithout ever naming a category. Categories exist to say what happens\n*between* sounds, which is the part the engine owns."
        },
        "bundle_manifest": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "entry_script": {
          "default": "scripts/main.luau",
          "type": "string"
        },
        "host_time": {
          "anyOf": [
            {
              "$ref": "#/$defs/HostTimeConfig"
            },
            {
              "type": "null"
            }
          ],
          "description": "Explicit opt-in demand-sampled host time; absent keeps deterministic legacy behavior."
        },
        "job_scripts": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Isolated Luau job modules, keyed by operation name.",
          "type": "object"
        },
        "main_scene": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": "string"
        },
        "render_pipeline": {
          "anyOf": [
            {
              "$ref": "#/$defs/RenderPipeline"
            },
            {
              "type": "null"
            }
          ],
          "description": "Ordered render passes the official hosts execute (ADR 0048). Undeclared\nkeeps each host's built-in order."
        },
        "runtime_packages": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Exact versions of SDK-bundled Luau runtime packages used by this project.\nDeclare @unone/ui before using api.ui.components constructors. This is\ncompatibility data, not a network resolver or filesystem module loader.",
          "type": "object"
        },
        "systems": {
          "additionalProperties": {
            "type": "boolean"
          },
          "default": {},
          "description": "Engine systems this game explicitly turns on or off.\n\nAnything not declared keeps the engine default; the engine rejects\nunknown ids instead of treating a typo as a disabled system.",
          "type": "object"
        },
        "test_files": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "ui_previews": {
          "default": [],
          "description": "Screens `verify` must check the layout of.\n\nWithout this only the opening screen is ever drawn, so a broken win or\nlose screen passes every gate. Each entry says how to reach a screen,\nthe same way `test_files` says how to reach a state worth asserting.",
          "items": {
            "$ref": "#/$defs/UiPreviewSpec"
          },
          "type": "array"
        },
        "verify": {
          "anyOf": [
            {
              "$ref": "#/$defs/VerifyConfig"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Which gates `verify` runs, in what order, and which of them are\nadvisory.\n\nUndeclared means the engine's default order with every gate required."
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "RenderParam": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "format": "double",
          "type": "number"
        },
        {
          "type": "string"
