{
  "$comment": "Generated from Rust deserialization types by game schema. Do not edit. Runtime semantic validators additionally check ranges, references, formats and capabilities.",
  "$defs": {
    "AnimationData": {
      "additionalProperties": false,
      "description": "Skeletal animation state an entity publishes for a host to play.\n\nThe engine stores which clip is selected and since which frame; it does not\nevaluate bones, meshes or blending. The only declared asset kind for this\ntoday is Spine, and the host owns that runtime.",
      "properties": {
        "animation": {
          "type": "string"
        },
        "asset": {
          "type": "string"
        },
        "loop": {
          "default": true,
          "type": "boolean"
        },
        "speed": {
          "default": 1.0,
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "asset",
        "animation"
      ],
      "type": "object"
    },
    "AudioCategory": {
      "additionalProperties": false,
      "description": "How a game groups its sounds, and what the engine does about the grouping.\n\nThe engine does not name `bgm` or `sfx`: the taxonomy is the game's. It owns\nonly the rules, because they decide which source survives a switch, and that\nis world state a test asserts.\n\nThe reserved fields exist so the declaration shape does not have to change\nwhen they are implemented. Declaring one is an **error**, never a silent\nno-op: a game believing it configured something it did not is the hardest\nkind of audio bug to find.",
      "properties": {
        "ducking": true,
        "exclusive": {
          "default": false,
          "description": "Only one loop in this category plays at a time; starting another begins\nstopping the previous one.",
          "type": "boolean"
        },
        "exclusive_group": true,
        "fade_in_frames": {
          "default": 0,
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "fade_out_frames": {
          "default": 0,
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "max_concurrent": true,
        "on_limit": true,
        "priority": true,
        "volume": {
          "default": 1.0,
          "description": "The bus level this category starts at, the way a mixer group has a\nvolume before anything plays. A settings screen changes it at runtime.",
          "format": "double",
          "type": "number"
        }
      },
      "type": "object"
    },
    "AudioConfig": {
      "additionalProperties": false,
      "properties": {
        "categories": {
          "additionalProperties": {
            "$ref": "#/$defs/AudioCategory"
          },
          "default": {},
          "type": "object"
        }
      },
      "type": "object"
    },
    "Body3D": {
      "additionalProperties": false,
      "properties": {
        "angular_damping": {
          "default": 0.0,
          "format": "double",
          "type": "number"
        },
        "angular_velocity": {
          "$ref": "#/$defs/Vec3",
          "default": {
            "x": 0.0,
            "y": 0.0,
            "z": 0.0
          }
        },
        "body_type": {
          "$ref": "#/$defs/BodyKind"
        },
        "can_sleep": {
          "default": true,
          "type": "boolean"
        },
        "ccd": {
          "default": false,
          "type": "boolean"
        },
        "filter": {
          "default": -1,
          "format": "int32",
          "type": "integer"
        },
        "friction": {
          "default": 0.5,
          "format": "double",
          "type": "number"
        },
        "gravity_scale": {
          "default": 1.0,
          "format": "double",
          "type": "number"
        },
        "linear_damping": {
          "default": 0.0,
          "format": "double",
          "type": "number"
        },
        "lock_rotation": {
          "default": false,
          "type": "boolean"
        },
        "mass": {
          "default": 1.0,
          "format": "double",
          "type": "number"
        },
        "membership": {
          "default": -1,
          "format": "int32",
          "type": "integer"
        },
        "restitution": {
          "default": 0.0,
          "format": "double",
          "type": "number"
        },
        "sensor": {
          "default": false,
          "type": "boolean"
        },
        "shape": {
          "$ref": "#/$defs/Shape3D"
        },
        "velocity": {
          "$ref": "#/$defs/Vec3",
          "default": {
            "x": 0.0,
            "y": 0.0,
            "z": 0.0
          }
        }
      },
      "required": [
        "body_type",
        "shape"
      ],
      "type": "object"
    },
    "BodyKind": {
      "enum": [
        "dynamic",
        "static",
        "kinematic"
      ],
      "type": "string"
    },
    "Camera2DData": {
      "additionalProperties": false,
      "properties": {
        "position": {
          "$ref": "#/$defs/Vec2",
          "default": {
            "x": 0.0,
            "y": 0.0
          }
        },
        "view_height": {
          "default": 10.0,
          "description": "World units visible vertically at zoom 1, centred on `position`.\n\nWithout this a host cannot know how much world a frame shows, so every\nhost invented its own constant and the same scene framed differently in\neach one. The visible height is `view_height / zoom`, and the visible\nwidth is that times the host's viewport aspect.",
          "format": "double",
          "type": "number"
        },
        "zoom": {
          "default": 1.0,
          "format": "double",
          "type": "number"
        }
      },
      "type": "object"
    },
    "Camera3DData": {
      "additionalProperties": false,
      "properties": {
        "fov_degrees": {
          "default": 60.0,
          "format": "double",
          "type": "number"
        },
        "position": {
          "$ref": "#/$defs/Vec3",
          "default": {
            "x": 0.0,
            "y": 3.0,
            "z": 8.0
          }
        },
        "target": {
          "$ref": "#/$defs/Vec3",
          "default": {
            "x": 0.0,
            "y": 0.0,
            "z": 0.0
          }
        }
      },
      "type": "object"
    },
    "Mesh3DData": {
      "additionalProperties": false,
      "properties": {
        "asset": {
          "type": "string"
        },
        "visible": {
          "default": true,
          "type": "boolean"
        }
      },
      "required": [
        "asset"
      ],
      "type": "object"
    },
    "ParticleDefinition": {
      "additionalProperties": false,
      "properties": {
        "duration_frames": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "emitters": {
          "items": {
            "$ref": "#/$defs/ParticleEmitter"
          },
          "type": "array"
        },
        "version": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "version",
        "duration_frames",
        "emitters"
      ],
      "type": "object"
    },
    "ParticleEasing": {
      "enum": [
        "linear",
        "ease_in",
        "ease_out",
        "smooth_step"
      ],
      "type": "string"
    },
    "ParticleEmissionShape": {
      "enum": [
        "point",
        "box",
        "sphere",
        "ring"
      ],
      "type": "string"
    },
    "ParticleEmitter": {
      "additionalProperties": false,
      "properties": {
        "additive": {
          "default": false,
          "type": "boolean"
        },
        "angular_velocity": {
          "default": 0.0,
          "format": "double",
          "type": "number"
        },
        "color_easing": {
          "$ref": "#/$defs/ParticleEasing",
          "default": "linear"
        },
        "color_end": {
          "items": {
            "format": "double",
            "type": "number"
          },
          "maxItems": 4,
          "minItems": 4,
          "type": "array"
        },
        "color_start": {
          "items": {
            "format": "double",
            "type": "number"
          },
          "maxItems": 4,
          "minItems": 4,
          "type": "array"
        },
        "cone_angle_degrees": {
          "default": 0.0,
          "format": "double",
          "type": "number"
        },
        "count": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "direction": {
          "$ref": "#/$defs/Vec3",
          "default": {
            "x": 0.0,
            "y": 0.0,
            "z": 0.0
          }
        },
        "emission_radius": {
          "default": 0.0,
          "format": "double",
          "type": "number"
        },
        "emission_shape": {
          "$ref": "#/$defs/ParticleEmissionShape",
          "default": "box"
        },
        "gravity": {
          "$ref": "#/$defs/Vec3",
          "default": {
            "x": 0.0,
            "y": 0.0,
            "z": 0.0
          }
        },
        "id": {
          "type": "string"
        },
        "interval_frames": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "lifetime_frames": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "rotation_end": {
          "default": 0.0,
          "format": "double",
          "type": "number"
        },
        "rotation_start": {
          "default": 0.0,
          "format": "double",
          "type": "number"
        },
        "size_easing": {
          "$ref": "#/$defs/ParticleEasing",
          "default": "linear"
        },
        "size_end": {
          "format": "double",
          "type": "number"
        },
        "size_start": {
          "format": "double",
          "type": "number"
        },
        "speed_max": {
          "default": 0.0,
          "format": "double",
          "type": "number"
        },
        "speed_min": {
          "default": 0.0,
          "format": "double",
          "type": "number"
        },
        "spread": {
          "$ref": "#/$defs/Vec3",
          "default": {
            "x": 0.0,
            "y": 0.0,
            "z": 0.0
          }
        },
        "sprite_shape": {
          "$ref": "#/$defs/ParticleSpriteShape",
          "default": "soft_circle"
        },
        "start_delay_frames": {
          "default": 0,
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "velocity_max": {
          "$ref": "#/$defs/Vec3",
          "default": {
            "x": 0.0,
            "y": 0.0,
            "z": 0.0
          }
        },
        "velocity_min": {
          "$ref": "#/$defs/Vec3",
          "default": {
            "x": 0.0,
            "y": 0.0,
            "z": 0.0
          }
        },
        "velocity_mode": {
          "$ref": "#/$defs/ParticleVelocityMode",
          "default": "vector"
        }
      },
      "required": [
        "id",
        "count",
        "interval_frames",
        "lifetime_frames",
        "size_start",
        "size_end",
        "color_start",
        "color_end"
