      "type": "object"
    },
    "ParticleSpriteShape": {
      "enum": [
        "soft_circle",
        "diamond",
        "ring",
        "streak"
      ],
      "type": "string"
    },
    "ParticleVelocityMode": {
      "enum": [
        "vector",
        "cone",
        "radial"
      ],
      "type": "string"
