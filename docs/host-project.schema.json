{
  "$comment": "Generated from Rust deserialization types by game schema. Do not edit. Runtime semantic validators additionally check ranges, references, formats and capabilities.",
  "$defs": {
    "AnimationData": {
      "additionalProperties": false,
      "description": "Skeletal animation state an entity publishes for a host to play.\n\nThe engine stores which clip is selected and since which frame; it does not\nevaluate bones, meshes or blending. The only declared asset kind for this\ntoday is Spine, and the host owns that runtime.",
      "properties": {
        "animation": {
          "type": "string"
        },
        "asset": {
          "type": "string"
        },
        "loop": {
          "default": true,
          "type": "boolean"
        },
        "speed": {
          "default": 1.0,
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "asset",
        "animation"
      ],
      "type": "object"
    },
    "AssetCatalogEntry": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind"
      ],
      "type": "object"
    },
    "AudioCategory": {
      "additionalProperties": false,
      "description": "How a game groups its sounds, and what the engine does about the grouping.\n\nThe engine does not name `bgm` or `sfx`: the taxonomy is the game's. It owns\nonly the rules, because they decide which source survives a switch, and that\nis world state a test asserts.\n\nThe reserved fields exist so the declaration shape does not have to change\nwhen they are implemented. Declaring one is an **error**, never a silent\nno-op: a game believing it configured something it did not is the hardest\nkind of audio bug to find.",
      "properties": {
        "ducking": true,
        "exclusive": {
          "default": false,
          "description": "Only one loop in this category plays at a time; starting another begins\nstopping the previous one.",
          "type": "boolean"
        },
        "exclusive_group": true,
        "fade_in_frames": {
          "default": 0,
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "fade_out_frames": {
          "default": 0,
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "max_concurrent": true,
        "on_limit": true,
        "priority": true,
        "volume": {
          "default": 1.0,
          "description": "The bus level this category starts at, the way a mixer group has a\nvolume before anything plays. A settings screen changes it at runtime.",
          "format": "double",
          "type": "number"
        }
      },
      "type": "object"
    },
    "AudioConfig": {
      "additionalProperties": false,
      "properties": {
        "categories": {
          "additionalProperties": {
            "$ref": "#/$defs/AudioCategory"
          },
          "default": {},
          "type": "object"
        }
      },
      "type": "object"
    },
    "Body3D": {
      "additionalProperties": false,
      "properties": {
        "angular_damping": {
          "default": 0.0,
          "format": "double",
          "type": "number"
        },
        "angular_velocity": {
          "$ref": "#/$defs/Vec3",
          "default": {
            "x": 0.0,
            "y": 0.0,
            "z": 0.0
          }
        },
        "body_type": {
          "$ref": "#/$defs/BodyKind"
        },
        "can_sleep": {
          "default": true,
          "type": "boolean"
        },
        "ccd": {
          "default": false,
          "type": "boolean"
        },
        "filter": {
          "default": -1,
          "format": "int32",
          "type": "integer"
        },
        "friction": {
          "default": 0.5,
          "format": "double",
          "type": "number"
        },
        "gravity_scale": {
          "default": 1.0,
          "format": "double",
          "type": "number"
        },
        "linear_damping": {
          "default": 0.0,
          "format": "double",
          "type": "number"
        },
        "lock_rotation": {
          "default": false,
          "type": "boolean"
        },
        "mass": {
          "default": 1.0,
          "format": "double",
          "type": "number"
        },
        "membership": {
          "default": -1,
          "format": "int32",
          "type": "integer"
        },
        "restitution": {
          "default": 0.0,
          "format": "double",
          "type": "number"
        },
        "sensor": {
          "default": false,
          "type": "boolean"
        },
        "shape": {
          "$ref": "#/$defs/Shape3D"
        },
        "velocity": {
          "$ref": "#/$defs/Vec3",
          "default": {
            "x": 0.0,
            "y": 0.0,
            "z": 0.0
          }
        }
      },
      "required": [
        "body_type",
        "shape"
      ],
      "type": "object"
    },
    "BodyKind": {
      "enum": [
        "dynamic",
        "static",
        "kinematic"
      ],
      "type": "string"
    },
    "Camera2DData": {
      "additionalProperties": false,
      "properties": {
        "position": {
          "$ref": "#/$defs/Vec2",
          "default": {
            "x": 0.0,
            "y": 0.0
          }
        },
        "view_height": {
          "default": 10.0,
          "description": "World units visible vertically at zoom 1, centred on `position`.\n\nWithout this a host cannot know how much world a frame shows, so every\nhost invented its own constant and the same scene framed differently in\neach one. The visible height is `view_height / zoom`, and the visible\nwidth is that times the host's viewport aspect.",
          "format": "double",
          "type": "number"
        },
        "zoom": {
          "default": 1.0,
          "format": "double",
          "type": "number"
        }
      },
      "type": "object"
    },
    "Camera3DData": {
      "additionalProperties": false,
      "properties": {
        "curvature": {
          "description": "Bends world geometry around the target point: in view space relative to\nthe target, y -= curvature * (x^2 + z^2). 0 disables it.",
          "format": "double",
          "type": "number"
        },
        "fov_degrees": {
          "default": 60.0,
          "format": "double",
          "type": "number"
        },
        "handedness": {
          "$ref": "#/$defs/CameraHandedness",
          "description": "How world coordinates map to the screen. `left` keeps x right, y up and\nz away from the viewer at identity, as in Direct3D and Unity."
        },
        "position": {
          "$ref": "#/$defs/Vec3",
          "default": {
            "x": 0.0,
            "y": 3.0,
            "z": 8.0
          }
        },
        "rect": {
          "anyOf": [
            {
              "$ref": "#/$defs/CameraRect"
            },
            {
              "type": "null"
            }
          ],
          "description": "Normalized viewport (lower-left origin) the view renders into; None is\nthe whole surface."
        },
        "target": {
          "$ref": "#/$defs/Vec3",
          "default": {
            "x": 0.0,
            "y": 0.0,
            "z": 0.0
          }
        }
      },
      "type": "object"
    },
    "CameraHandedness": {
      "enum": [
        "right",
        "left"
      ],
      "type": "string"
    },
    "CameraRect": {
      "additionalProperties": false,
      "properties": {
        "height": {
          "format": "double",
          "type": "number"
        },
        "width": {
          "format": "double",
          "type": "number"
        },
        "x": {
          "format": "double",
          "type": "number"
        },
        "y": {
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "type": "object"
    },
    "DataAssetDecl": {
      "additionalProperties": false,
      "description": "One data asset a project declares: where the host finds its bytes and which\nloader turns them into a Luau value.",
      "properties": {
        "id": {
          "type": "string"
        },
        "loader": {
          "description": "The manifest's `encoding.decoder`, or \"bytes\" without an encoding.",
          "type": "string"
        },
        "source": {
          "description": "Project-relative path; exports serve it under `content/`.",
          "type": "string"
        }
      },
      "required": [
        "id",
        "source",
        "loader"
      ],
      "type": "object"
    },
    "HostTimeConfig": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "mode": {
              "const": "live",
              "type": "string"
            }
          },
          "required": [
            "mode"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "max_samples": {
              "default": 1000000,
              "format": "uint",
              "minimum": 0,
              "type": "integer"
            },
            "max_transactions": {
              "default": 1000000,
              "format": "uint",
              "minimum": 0,
              "type": "integer"
            },
            "mode": {
              "const": "record",
              "type": "string"
            }
          },
          "required": [
            "mode"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "mode": {
              "const": "replay",
              "type": "string"
            },
            "tape": {
              "$ref": "#/$defs/HostTimeTape"
            }
          },
          "required": [
            "mode",
            "tape"
          ],
          "type": "object"
        }
      ]
    },
    "HostTimeSample": {
      "additionalProperties": false,
      "properties": {
        "milliseconds": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "tag": {
          "type": "string"
        }
      },
      "required": [
        "tag",
        "milliseconds"
      ],
      "type": "object"
    },
    "HostTimeTape": {
      "additionalProperties": false,
      "description": "Schema 1 is runtime-creation-origin, floor elapsed milliseconds, safe integer.\nEpoch labels are identities supplied by the recording host, never OS uptime.",
      "properties": {
        "schema_version": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "source_epoch": {
          "default": "runtime-creation",
          "type": "string"
        },
        "transactions": {
          "items": {
            "$ref": "#/$defs/HostTimeTransaction"
          },
          "type": "array"
        }
      },
      "required": [
        "schema_version",
        "transactions"
      ],
      "type": "object"
    },
    "HostTimeTransaction": {
      "additionalProperties": false,
      "properties": {
        "frame": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "phase": {
          "type": "string"
        },
        "samples": {
          "items": {
            "$ref": "#/$defs/HostTimeSample"
          },
          "type": "array"
        }
      },
      "required": [
        "phase",
        "frame",
        "samples"
      ],
      "type": "object"
    },
    "Mesh3DData": {
      "additionalProperties": false,
      "properties": {
        "asset": {
          "type": "string"
        },
        "visible": {
          "default": true,
          "type": "boolean"
        }
      },
      "required": [
        "asset"
      ],
      "type": "object"
    },
    "ParticleDefinition": {
      "additionalProperties": false,
