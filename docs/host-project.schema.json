          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "half_extents": {
              "$ref": "#/$defs/Vec3"
            },
            "kind": {
              "const": "box",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "half_extents"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "half_height": {
              "format": "double",
              "type": "number"
            },
            "kind": {
              "const": "capsule",
              "type": "string"
            },
            "radius": {
              "format": "double",
              "type": "number"
            }
          },
          "required": [
            "kind",
            "half_height",
            "radius"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "convex",
              "type": "string"
            },
            "vertices": {
              "items": {
                "$ref": "#/$defs/Vec3"
              },
              "type": "array"
            }
          },
          "required": [
            "kind",
            "vertices"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "indices": {
              "items": {
                "items": {
                  "format": "uint32",
                  "minimum": 0,
                  "type": "integer"
                },
                "maxItems": 3,
                "minItems": 3,
                "type": "array"
              },
              "type": "array"
            },
            "kind": {
              "const": "trimesh",
              "type": "string"
            },
            "vertices": {
              "items": {
                "$ref": "#/$defs/Vec3"
              },
              "type": "array"
            }
          },
          "required": [
            "kind",
            "vertices",
            "indices"
          ],
          "type": "object"
        }
      ]
    },
    "SpriteData": {
      "additionalProperties": false,
      "properties": {
        "asset": {
          "type": "string"
        },
        "layer": {
          "default": 0,
          "description": "Painter layer. Lower layers are drawn first; same-layer order is the\nascending entity id, which is the portable tie-break used by hosts.",
          "format": "int32",
          "type": "integer"
        },
        "size": {
          "$ref": "#/$defs/Vec2",
          "default": {
            "x": 1.0,
            "y": 1.0
          }
        },
        "visible": {
          "default": true,
          "type": "boolean"
        }
      },
      "required": [
        "asset"
      ],
      "type": "object"
    },
    "Transform3DData": {
      "additionalProperties": false,
      "properties": {
        "position": {
          "$ref": "#/$defs/Vec3",
          "default": {
            "x": 0.0,
            "y": 0.0,
            "z": 0.0
          }
        },
        "rotation": {
          "$ref": "#/$defs/Vec3",
          "default": {
            "x": 0.0,
            "y": 0.0,
            "z": 0.0
          },
          "description": "Euler rotation in radians. The engine stores the transform; game code\nowns the meaning of steering and other gameplay-specific orientation."
        },
        "scale": {
          "$ref": "#/$defs/Vec3",
          "default": {
            "x": 1.0,
            "y": 1.0,
            "z": 1.0
          }
        }
      },
      "type": "object"
    },
    "UiPreviewSpec": {
      "additionalProperties": false,
      "description": "One reachable screen the layout gate should inspect.",
      "properties": {
        "frames": {
          "default": 1,
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "input_sequence": {
          "default": null,
          "description": "Project-relative per-frame input replay that reaches this screen.",
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": "string"
        },
        "overlap_policy": {
          "default": null,
          "description": "Project-relative exact image-behind-control overlap policy for this preview.",
          "type": [
            "string",
            "null"
          ]
        },
        "seed": {
          "default": 42,
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "Vec2": {
      "additionalProperties": false,
      "properties": {
        "x": {
          "format": "double",
          "type": "number"
        },
        "y": {
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "type": "object"
    },
    "Vec3": {
      "additionalProperties": false,
      "properties": {
        "x": {
          "format": "double",
          "type": "number"
        },
        "y": {
          "format": "double",
          "type": "number"
        },
        "z": {
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y",
        "z"
      ],
      "type": "object"
    },
    "VerifyConfig": {
      "additionalProperties": false,
      "description": "The gates this project wants `verify` to run.\n\nThe default order is the engine's opinion, not a law. A project that draws\nno screen, or that is mid-way through acquiring assets, should be able to\nsay so once in its config rather than teaching its author to read past a\nred line — a gate people learn to ignore is worse than a gate that says it\nis advisory.",
      "properties": {
        "steps": {
          "default": [],
          "items": {
            "$ref": "#/$defs/VerifyStepSpec"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "VerifyStepDetail": {
      "additionalProperties": false,
      "properties": {
        "command": {
          "default": null,
          "description": "Reserved: a project-owned command as a gate. Declaring it is an error in\nthis build rather than a step that silently never runs."
        },
        "required": {
          "default": true,
          "description": "A failing advisory gate is reported and does not fail the run.",
          "type": "boolean"
        },
        "step": {
          "type": "string"
        }
      },
      "required": [
        "step"
      ],
      "type": "object"
    },
    "VerifyStepSpec": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "$ref": "#/$defs/VerifyStepDetail"
        }
      ],
      "description": "One declared gate: either the bare id, or the id with its settings."
    }
  },
  "$id": "https://unone.dev/schema/host-project.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "config": {
      "$ref": "#/$defs/ProjectConfig"
    },
    "job_sources": {
      "additionalProperties": {
        "type": "string"
      },
      "default": {},
      "type": "object"
    },
    "restored_save": {
      "default": null,
      "description": "Restored state is available in Game.start, never injected after startup."
    },
    "scene": {
      "anyOf": [
        {
          "$ref": "#/$defs/SceneFile"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "script": {
      "type": "string"
    },
    "viewport_aspect": {
      "default": null,
      "description": "UI viewport aspect, supplied before Game.start; defaults to 16:9.",
      "format": "double",
      "type": [
        "number",
        "null"
      ]
    }
  },
  "required": [
    "config",
    "script"
  ],
  "title": "HostProject",
  "type": "object"
}
