              "x": 0.0,
              "y": -9.8
            },
            "ground_friction": 0.0,
            "ground_y": null,
            "linear_damping": 0.0
          }
        },
        "physics3d": {
          "anyOf": [
            {
              "$ref": "#/$defs/Physics3DScene"
            },
            {
              "type": "null"
            }
          ],
          "default": null
