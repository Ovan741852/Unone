        "dynamic",
        "static"
      ],
      "type": "string"
    },
    "SceneEntity": {
      "additionalProperties": false,
      "properties": {
        "animation": {
          "anyOf": [
            {
              "$ref": "#/$defs/AnimationData"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "id": {
          "type": "string"
        },
        "mesh3d": {
          "anyOf": [
            {
              "$ref": "#/$defs/Mesh3DData"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "name": {
          "default": "",
          "type": "string"
        },
        "rigidbody": {
          "anyOf": [
            {
              "$ref": "#/$defs/RigidBody2DData"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "rotation": {
          "default": 0.0,
          "description": "Visual-only 2D rotation in radians around the sprite centre.",
          "format": "double",
          "type": "number"
        },
        "scale": {
          "$ref": "#/$defs/Vec2",
          "default": {
            "x": 1.0,
            "y": 1.0
          },
          "description": "Visual-only 2D scale applied to the sprite's declared size."
        },
        "shader_material": {
          "type": [
            "string",
            "null"
          ]
        },
        "sprite": {
          "anyOf": [
            {
              "$ref": "#/$defs/SpriteData"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "sprite_animation": {
          "anyOf": [
            {
              "$ref": "#/$defs/SpriteAnimationData"
            },
            {
              "type": "null"
            }
          ],
          "description": "Fixed-tick frame animation over the sprite's sheet cells."
        },
        "transform": {
          "$ref": "#/$defs/Vec2",
          "default": {
            "x": 0.0,
            "y": 0.0
          }
        },
        "transform3d": {
          "anyOf": [
            {
              "$ref": "#/$defs/Transform3DData"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id"
      ],
      "type": "object"
    },
    "SceneFile": {
      "additionalProperties": false,
      "properties": {
        "camera": {
          "default": {
            "position": {
              "x": 0.0,
              "y": 0.0
            },
            "view_height": 10.0,
            "zoom": 1.0
          },
          "description": "The one authoring entry point for the active camera. Legacy 2D and\nsplit `camera3d` input is still accepted by the custom deserializer,\nbut the generated schema advertises the unified forms first.",
          "oneOf": [
            {
              "$ref": "#/$defs/Camera2DData"
            },
            {
              "additionalProperties": false,
              "description": "Orthographic projection. `orthographicSize` is the visible world height; `position` may be Vec2 or Vec3 (z is ignored).",
              "properties": {
                "orthographicSize": {
                  "format": "double",
                  "type": "number"
                },
                "orthographic_size": {
                  "format": "double",
                  "type": "number"
                },
                "position": {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/Vec2"
                    },
                    {
                      "$ref": "#/$defs/Vec3"
                    }
                  ]
                },
                "projection": {
                  "const": "orthographic",
                  "type": "string"
                },
                "view_height": {
                  "format": "double",
                  "type": "number"
                },
                "zoom": {
                  "format": "double",
                  "type": "number"
                }
              },
              "type": "object"
            },
            {
              "additionalProperties": false,
              "description": "Perspective projection for 3D scenes.",
              "properties": {
                "fovDegrees": {
                  "format": "double",
                  "type": "number"
                },
                "fov_degrees": {
                  "format": "double",
                  "type": "number"
                },
                "position": {
                  "$ref": "#/$defs/Vec3"
                },
                "projection": {
                  "const": "perspective",
                  "type": "string"
                },
                "target": {
                  "$ref": "#/$defs/Vec3"
                }
              },
              "required": [
                "target"
              ],
              "type": "object"
            }
          ]
        },
        "camera3d": {
          "anyOf": [
            {
              "$ref": "#/$defs/Camera3DData"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Legacy split perspective storage. New source files should put the\nprojection in `camera`; this field is accepted only for compatibility\nand is intentionally omitted by canonical serialization."
        },
        "entities": {
          "default": [],
          "items": {
            "$ref": "#/$defs/SceneEntity"
          },
          "type": "array"
        },
        "particle_effects": {
          "additionalProperties": {
            "$ref": "#/$defs/ParticleDefinition"
          },
          "default": {},
          "type": "object"
        },
        "physics": {
          "$ref": "#/$defs/PhysicsSettings",
          "default": {
            "gravity": {
              "x": 0.0,
              "y": -9.8
            },
            "ground_friction": 0.0,
            "ground_y": null,
            "linear_damping": 0.0
          }
        },
        "physics3d": {
          "anyOf": [
            {
              "$ref": "#/$defs/Physics3DScene"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "shader_materials": {
          "additionalProperties": {
            "$ref": "#/$defs/ShaderMaterialDefinition"
          },
          "default": {},
          "type": "object"
        }
      },
      "type": "object"
    },
    "ScriptBytecodeDecl": {
      "additionalProperties": false,
      "description": "Declares the precompiled entry script in a host payload in place of `script`.",
      "properties": {
        "byte_length": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "format": {
          "description": "Compiler identity; must equal the loading runtime's `script_bytecode_format`.",
          "type": "string"
        },
        "source": {
          "description": "Content-relative file the host fetches and stages as SCRIPT_BYTECODE_DATA_ID.",
          "type": "string"
        }
      },
      "required": [
        "source",
        "format",
        "byte_length"
      ],
      "type": "object"
    },
    "ShaderMaterialDefinition": {
      "additionalProperties": false,
      "properties": {
        "fragment": {
          "description": "GLSL ES 1.00 function: vec4 unoneShade(vec2 uv, vec4 color).",
          "type": "string"
        },
        "uniforms": {
          "additionalProperties": {
            "$ref": "#/$defs/ShaderUniform"
          },
          "default": {},
          "type": "object"
        }
      },
      "required": [
        "fragment"
      ],
      "type": "object"
    },
    "ShaderUniform": {
      "anyOf": [
        {
          "format": "double",
          "type": "number"
        },
        {
          "items": {
            "format": "double",
            "type": "number"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        },
        {
          "items": {
            "format": "double",
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "type": "array"
        },
        {
          "items": {
            "format": "double",
            "type": "number"
          },
          "maxItems": 4,
          "minItems": 4,
          "type": "array"
        }
      ]
    },
    "Shape3D": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "sphere",
              "type": "string"
            },
            "radius": {
              "format": "double",
              "type": "number"
            }
          },
          "required": [
            "kind",
            "radius"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "half_extents": {
              "$ref": "#/$defs/Vec3"
            },
            "kind": {
              "const": "box",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "half_extents"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "half_height": {
              "format": "double",
              "type": "number"
            },
            "kind": {
              "const": "capsule",
              "type": "string"
            },
            "radius": {
              "format": "double",
              "type": "number"
            }
          },
          "required": [
            "kind",
            "half_height",
            "radius"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "convex",
              "type": "string"
            },
            "vertices": {
              "items": {
                "$ref": "#/$defs/Vec3"
              },
              "type": "array"
            }
          },
          "required": [
            "kind",
            "vertices"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "indices": {
              "items": {
                "items": {
                  "format": "uint32",
                  "minimum": 0,
                  "type": "integer"
                },
                "maxItems": 3,
                "minItems": 3,
                "type": "array"
              },
              "type": "array"
            },
            "kind": {
              "const": "trimesh",
              "type": "string"
            },
            "vertices": {
              "items": {
                "$ref": "#/$defs/Vec3"
              },
              "type": "array"
            }
          },
          "required": [
            "kind",
            "vertices",
            "indices"
          ],
          "type": "object"
        }
      ]
    },
    "SpriteAnimationData": {
      "additionalProperties": false,
      "description": "A clip of sprite sheet cells the engine steps on the fixed tick.\n\nThe engine resolves the current cell into `sprite.frame` every observation,\nso hosts only map a cell to texture coordinates and replays stay exact.",
      "properties": {
        "fps": {
          "description": "Cells per second of fixed-tick time.",
          "format": "double",
          "type": "number"
        },
        "frames": {
          "description": "Sheet cells in play order, numbered from 0 left to right, then top to\nbottom. A cell may repeat to hold it longer.",
          "items": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "type": "array"
        },
        "loop": {
          "default": true,
          "type": "boolean"
        }
      },
      "required": [
        "frames",
        "fps"
      ],
      "type": "object"
    },
    "SpriteData": {
      "additionalProperties": false,
      "properties": {
        "asset": {
          "type": "string"
        },
        "frame": {
          "description": "Sheet cell to draw, numbered from 0 left to right, then top to bottom.\nWhile a sprite animation plays, observations carry its current cell.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "layer": {
          "default": 0,
          "description": "Painter layer. Lower layers are drawn first; same-layer order is the\nascending entity id, which is the portable tie-break used by hosts.",
          "format": "int32",
          "type": "integer"
        },
        "sheet": {
          "anyOf": [
            {
              "$ref": "#/$defs/SpriteSheet"
            },
            {
              "type": "null"
            }
          ],
          "description": "Splits the texture into equal cells so the sprite draws one of them."
        },
        "size": {
          "$ref": "#/$defs/Vec2",
          "default": {
            "x": 1.0,
            "y": 1.0
          }
        },
        "visible": {
          "default": true,
          "type": "boolean"
        }
      },
      "required": [
        "asset"
      ],
      "type": "object"
    },
    "SpriteSheet": {
      "additionalProperties": false,
      "description": "A grid of equally sized cells covering the whole texture.",
      "properties": {
        "columns": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "rows": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "columns",
        "rows"
      ],
      "type": "object"
    },
    "Transform3DData": {
      "additionalProperties": false,
      "properties": {
        "position": {
          "$ref": "#/$defs/Vec3",
          "default": {
            "x": 0.0,
            "y": 0.0,
            "z": 0.0
          }
        },
        "rotation": {
          "$ref": "#/$defs/Vec3",
          "default": {
            "x": 0.0,
            "y": 0.0,
            "z": 0.0
          },
          "description": "Euler rotation in radians. The engine stores the transform; game code\nowns the meaning of steering and other gameplay-specific orientation."
        },
        "scale": {
          "$ref": "#/$defs/Vec3",
          "default": {
            "x": 1.0,
            "y": 1.0,
            "z": 1.0
          }
        }
      },
      "type": "object"
    },
    "UiPreviewSpec": {
      "additionalProperties": false,
      "description": "One reachable screen the layout gate should inspect.",
      "properties": {
        "frames": {
          "default": 1,
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "input_sequence": {
          "default": null,
          "description": "Project-relative per-frame input replay that reaches this screen.",
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": "string"
        },
        "overlap_policy": {
          "default": null,
          "description": "Project-relative exact image-behind-control overlap policy for this preview.",
          "type": [
            "string",
            "null"
          ]
        },
        "save_fixture": {
          "description": "Tool-only project-relative JSON save restored before Game.start.\nOmitted from serialized/exported project payloads and production files.",
          "type": [
            "string",
            "null"
          ],
          "writeOnly": true
        },
        "seed": {
          "default": 42,
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "Vec2": {
      "additionalProperties": false,
      "properties": {
        "x": {
          "format": "double",
          "type": "number"
        },
        "y": {
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "type": "object"
    },
    "Vec3": {
      "additionalProperties": false,
      "properties": {
        "x": {
          "format": "double",
          "type": "number"
        },
        "y": {
          "format": "double",
          "type": "number"
        },
        "z": {
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y",
        "z"
      ],
      "type": "object"
    },
    "VerifyConfig": {
      "additionalProperties": false,
      "description": "The gates this project wants `verify` to run.\n\nThe default order is the engine's opinion, not a law. A project that draws\nno screen, or that is mid-way through acquiring assets, should be able to\nsay so once in its config rather than teaching its author to read past a\nred line — a gate people learn to ignore is worse than a gate that says it\nis advisory.",
      "properties": {
        "steps": {
          "default": [],
          "items": {
            "$ref": "#/$defs/VerifyStepSpec"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "VerifyStepDetail": {
      "additionalProperties": false,
      "properties": {
        "command": {
          "default": null,
          "description": "Reserved: a project-owned command as a gate. Declaring it is an error in\nthis build rather than a step that silently never runs."
        },
        "required": {
          "default": true,
          "description": "A failing advisory gate is reported and does not fail the run.",
          "type": "boolean"
        },
        "step": {
          "type": "string"
        }
      },
      "required": [
        "step"
      ],
      "type": "object"
    },
    "VerifyStepSpec": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "$ref": "#/$defs/VerifyStepDetail"
        }
      ],
      "description": "One declared gate: either the bare id, or the id with its settings."
    }
  },
  "$id": "https://unone.dev/schema/host-project.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "asset_catalog": {
      "description": "Declared presentation assets; bytes and decoded/GPU objects stay in the host.",
      "items": {
        "$ref": "#/$defs/AssetCatalogEntry"
      },
      "type": "array"
    },
    "config": {
      "$ref": "#/$defs/ProjectConfig"
    },
    "data_assets": {
      "description": "Data assets the game reads with api.assets.load. The host delivers their\nbytes beside this JSON (into_runtime_with_data), never inside it.",
      "items": {
        "$ref": "#/$defs/DataAssetDecl"
      },
      "type": "array"
    },
    "job_sources": {
      "additionalProperties": {
        "type": "string"
      },
      "default": {},
      "type": "object"
    },
    "restored_save": {
      "default": null,
      "description": "Restored state is available in Game.start, never injected after startup."
    },
    "scene": {
      "anyOf": [
        {
          "$ref": "#/$defs/SceneFile"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "script": {
      "default": "",
      "description": "Entry script source; empty when `script_bytecode` declares a precompiled chunk.",
      "type": "string"
    },
    "script_bytecode": {
      "anyOf": [
        {
          "$ref": "#/$defs/ScriptBytecodeDecl"
        },
        {
          "type": "null"
        }
      ],
      "description": "Precompiled entry script in place of `script`. Its bytes travel beside this\nJSON as staged data SCRIPT_BYTECODE_DATA_ID, never inside it."
    },
    "viewport_aspect": {
      "default": null,
      "description": "UI viewport aspect, supplied before Game.start; defaults to 16:9.\nIgnored when viewport_size is present: the physical size then defines\nthe aspect exactly, so hosts may send a rounded CSS aspect alongside it.",
      "format": "double",
      "type": [
        "number",
        "null"
      ]
    },
    "viewport_size": {
      "default": null,
      "description": "Physical render-target pixels, supplied before Game.start when known.",
      "items": {
        "format": "uint32",
        "minimum": 0,
        "type": "integer"
      },
      "maxItems": 2,
      "minItems": 2,
      "type": [
        "array",
        "null"
      ]
    }
  },
  "required": [
    "config"
  ],
  "title": "HostProject",
  "type": "object"
}
