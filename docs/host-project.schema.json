        },
        "cone_angle_degrees": {
          "default": 0.0,
          "format": "double",
          "type": "number"
        },
        "count": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "direction": {
          "$ref": "#/$defs/Vec3",
          "default": {
            "x": 0.0,
            "y": 0.0,
            "z": 0.0
          }
        },
        "emission_radius": {
          "default": 0.0,
          "format": "double",
          "type": "number"
        },
        "emission_shape": {
          "$ref": "#/$defs/ParticleEmissionShape",
          "default": "box"
        },
        "gravity": {
          "$ref": "#/$defs/Vec3",
          "default": {
            "x": 0.0,
            "y": 0.0,
            "z": 0.0
          }
        },
        "id": {
          "type": "string"
        },
