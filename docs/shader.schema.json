{
  "$comment": "Generated from Rust deserialization types by game schema. Do not edit. Runtime semantic validators additionally check ranges, references, formats and capabilities.",
  "$defs": {
    "ShaderAttribute": {
      "additionalProperties": false,
      "description": "A named per-vertex input of 1..4 floats.",
      "properties": {
        "name": {
          "type": "string"
        },
        "size": {
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "name",
        "size"
      ],
      "type": "object"
    },
    "ShaderInterpolation": {
      "oneOf": [
        {
          "const": "smooth",
          "description": "Interpolated across the triangle.",
          "type": "string"
        },
        {
          "const": "flat",
          "description": "The triangle's provoking (last) vertex value everywhere.",
          "type": "string"
        }
      ]
    },
    "ShaderSampler": {
      "additionalProperties": false,
      "description": "A texture input of both mesh stages. Unbound samplers read zero.",
      "properties": {
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/ShaderTextureSource"
            },
            {
              "type": "null"
            }
          ]
        },
        "type": {
          "$ref": "#/$defs/ShaderSamplerType",
          "default": "float"
        }
      },
      "type": "object"
    },
    "ShaderSamplerType": {
      "oneOf": [
        {
          "const": "float",
          "description": "`sampler2D`: image assets and rgba8/float data textures.",
          "type": "string"
        },
        {
          "const": "int",
          "description": "`isampler2D`: r32i/rgba32i data textures, read exactly with texelFetch.",
          "type": "string"
        }
      ]
    },
    "ShaderTextureSource": {
      "description": "What a sampler reads.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "A declared texture2d asset.",
          "properties": {
            "asset": {
              "type": "string"
            }
          },
          "required": [
            "asset"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A runtime data texture (`api.texture`), bound with `api.shader.setTexture`.",
          "properties": {
            "data": {
              "type": "string"
            }
          },
          "required": [
            "data"
          ],
          "type": "object"
        }
      ]
    },
    "ShaderUniform": {
      "anyOf": [
        {
          "format": "double",
          "type": "number"
        },
        {
          "items": {
            "format": "double",
            "type": "number"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        },
        {
          "items": {
            "format": "double",
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "type": "array"
        },
        {
          "items": {
            "format": "double",
            "type": "number"
          },
          "maxItems": 4,
          "minItems": 4,
          "type": "array"
        }
      ]
    },
    "ShaderVarying": {
      "additionalProperties": false,
      "description": "A value of 1..4 floats the vertex stage writes and the fragment stage reads.",
      "properties": {
        "interpolation": {
          "$ref": "#/$defs/ShaderInterpolation",
          "default": "smooth"
        },
        "name": {
          "type": "string"
        },
        "size": {
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "name",
        "size"
      ],
      "type": "object"
    }
  },
  "$id": "https://unone.dev/schema/shader.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A declared material: the stages and the interface between mesh data, the\nvertex stage and the fragment stage. Sprites use only the fragment stage.",
  "properties": {
    "attributes": {
      "description": "Extra floats each vertex of a mesh using this material carries after\nits color, in this order; the vertex stage reads them by name.",
      "items": {
        "$ref": "#/$defs/ShaderAttribute"
      },
      "type": "array"
    },
    "fragment": {
      "description": "GLSL ES 1.00 function: vec4 unoneShade(vec2 uv, vec4 color).",
      "type": "string"
    },
    "samplers": {
      "additionalProperties": {
        "$ref": "#/$defs/ShaderSampler"
      },
      "description": "Texture inputs of both stages: lookup tables, palettes, data maps.",
      "type": "object"
    },
    "uniforms": {
      "additionalProperties": {
        "$ref": "#/$defs/ShaderUniform"
      },
      "default": {},
      "type": "object"
    },
    "varyings": {
      "description": "Values passed from the vertex stage to the fragment stage by name.",
      "items": {
        "$ref": "#/$defs/ShaderVarying"
      },
      "type": "array"
    },
    "vertex": {
      "description": "GLSL ES 3.00 function `vec4 unoneVertex(vec3 position, mat4 model)`\nreturning the clip-space position. Only geometry3d meshes have a vertex\nstage, so a material declaring one cannot shade sprites.",
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "fragment"
  ],
  "title": "ShaderMaterialDefinition",
  "type": "object"
}
