{
  "query": "observation array",
  "matches": [
    {
      "name": "observation.array",
      "category": "observation",
      "purpose": "Preserve a generic JSON array, including an empty array, in published observations.",
      "when_to_use": "For empty arrays, typed numeric arrays and engine JSON round trips. Engine-produced spatial results already preserve array identity automatically. Read docs/spatial-batches.md#observation-json-arrays, bundled with the SDK.",
      "when_not_to_use": "Plain {} remains a JSON object. This is a serialization hint, not gameplay state or a collection framework.",
      "parameters": [
        {
          "name": "values",
          "type_name": "{T}?",
          "meaning": "Optional contiguous serializable array table; omitted creates an empty array. Returns the same supplied table and retains its element types."
        }
      ],
      "returns": "{T}; no-argument call returns {ObservationValue}",
      "side_effects": [
        "Mark only this table's JSON array identity; no element copy or metatable changes"
      ],
      "frame_semantics": "The mark survives clearing and refilling this table. Serialization revalidates shape; nested plain empty tables remain objects unless separately marked. Invalid input fails before marking.",
      "common_errors": [
        "Mixed or sparse keys, callbacks, nonfinite values, buffers and cyclic values fail explicitly; marking does not bypass observation validation."
      ],
      "example": "api.observation.set(\"empty\", api.observation.array()); local numbers: {number} = {1,2}; api.observation.setArray(\"numbers\", api.observation.array(numbers))",
      "related_apis": [
        "observation.set",
        "observation.setArray",
        "spatial.take"
      ]
    },
    {
      "name": "observation.setArray",
      "category": "observation",
      "purpose": "Publish a typed generic array as JSON, including an empty array, with runtime serialization validation.",
      "when_to_use": "For direct publication of typed number/record arrays without casts or element adapters. Read docs/spatial-batches.md#observation-json-arrays in the SDK.",
      "when_not_to_use": "Does not weaken observation.set's recursive value type. Serializability and contiguous keys are runtime constraints on the generic element type.",
      "parameters": [
        {
          "name": "key",
          "type_name": "string",
          "meaning": "Nonempty observation key"
        },
        {
          "name": "values",
          "type_name": "{T}?",
          "meaning": "Contiguous serializable array; omitted publishes []"
        }
      ],
      "returns": "nil",
      "side_effects": [
        "Validate, mark array identity and replace only the named observation after success"
      ],
      "frame_semantics": "The supplied table is not copied by the marker; publication stores a JSON snapshot. Invalid input preserves the previous observation. Numeric element typing remains intact.",
      "common_errors": [
        "Invalid key, holes/mixed keys, functions, nonfinite values, buffers or cycles fail explicitly without publishing a replacement."
      ],
      "example": "local points: {number} = {1,2,3}; api.observation.setArray(\"points\", points); api.observation.setArray(\"empty\")",
      "related_apis": [
        "observation.set",
        "observation.array",
        "spatial.take"
      ]
    }
  ],
  "suggested_next_actions": []
}
