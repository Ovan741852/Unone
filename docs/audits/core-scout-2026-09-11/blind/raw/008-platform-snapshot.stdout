            "api.physics3d.contacts"
          ],
          "observation": [
            "physics3d"
          ],
          "when_disabled": "api.physics3d reports SYSTEM_DISABLED.",
          "disable_when": "Games without 3D projectile queries.",
          "enabled": false,
          "source": "default"
        },
        {
          "id": "physics2d",
          "summary": "Fixed-step integration for 2D rigid bodies: gravity, linear damping, ground bounce and friction, and circle collisions with per-frame contact points. There is no angular velocity, non-circular collider, sensor, or raycast.",
          "status": "available",
          "default_enabled": true,
          "optional": true,
          "build_feature": "physics2d",
          "compiled": true,
          "luau_api": [
            "api.physics.applyImpulse",
            "api.entity.despawn"
          ],
          "observation": [
            "world.entities[].rigidbody",
            "world.contacts",
            "world.ground_contacts"
          ],
          "when_disabled": "When disabled, the engine advances no rigid bodies and publishes no contacts; RigidBody2D keeps its scene initial values and api.physics reports SYSTEM_DISABLED.",
          "disable_when": "Games without physics simulation, such as board, idle, AVG, and slot games; disabling this removes per-frame integration cost and unnecessary digest changes.",
          "enabled": true,
          "source": "default"
        },
        {
