{
  "$comment": "Generated from Rust deserialization types by game schema. Do not edit. Runtime semantic validators additionally check ranges, references, formats and capabilities.",
  "$defs": {
    "ParticleColorKey": {
      "additionalProperties": false,
      "description": "One point of an RGBA curve over a particle's life (`t` 0 at birth, 1 at death).",
      "properties": {
        "color": {
          "items": {
            "format": "double",
            "type": "number"
          },
          "maxItems": 4,
          "minItems": 4,
          "type": "array"
        },
        "t": {
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "t",
        "color"
      ],
      "type": "object"
    },
    "ParticleEasing": {
      "enum": [
        "linear",
        "ease_in",
        "ease_out",
        "smooth_step"
      ],
      "type": "string"
    },
    "ParticleEmissionShape": {
      "enum": [
        "point",
        "box",
        "sphere",
        "ring"
      ],
      "type": "string"
    },
    "ParticleEmitter": {
      "additionalProperties": false,
      "properties": {
        "additive": {
          "default": false,
          "type": "boolean"
        },
        "align_to_velocity": {
          "description": "Rotation follows the direction of travel in the XY plane; rotation fields add to it.",
          "type": "boolean"
        },
        "angular_velocity": {
          "default": 0.0,
          "format": "double",
          "type": "number"
        },
        "angular_velocity_random": {
          "description": "Each particle's angular velocity is offset by +/- up to this many radians per second.",
          "format": "double",
          "type": "number"
        },
        "color_easing": {
          "$ref": "#/$defs/ParticleEasing",
          "default": "linear"
        },
        "color_end": {
          "items": {
            "format": "double",
            "type": "number"
          },
          "maxItems": 4,
          "minItems": 4,
          "type": "array"
        },
        "color_keys": {
          "description": "RGBA over life as 2-8 keys (for example fade in, hold, fade out); replaces color_start/color_end/color_easing.",
          "items": {
            "$ref": "#/$defs/ParticleColorKey"
          },
          "type": "array"
        },
        "color_start": {
          "items": {
            "format": "double",
            "type": "number"
          },
          "maxItems": 4,
          "minItems": 4,
          "type": "array"
        },
        "cone_angle_degrees": {
          "default": 0.0,
          "format": "double",
          "type": "number"
        },
        "count": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "direction": {
          "$ref": "#/$defs/Vec3",
          "default": {
            "x": 0.0,
            "y": 0.0,
            "z": 0.0
          }
        },
        "drag": {
          "description": "Linear drag per second: velocity decays by e^(-drag*t), so fast launches settle (confetti, dust, sparks).",
          "format": "double",
          "type": "number"
        },
        "emission_radius": {
          "default": 0.0,
          "format": "double",
          "type": "number"
        },
        "emission_shape": {
          "$ref": "#/$defs/ParticleEmissionShape",
          "default": "box"
        },
        "gravity": {
          "$ref": "#/$defs/Vec3",
          "default": {
            "x": 0.0,
            "y": 0.0,
            "z": 0.0
          }
        },
        "id": {
          "type": "string"
        },
        "interval_frames": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "lifetime_frames": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "lifetime_random_frames": {
          "description": "Each particle lives up to this many frames less than lifetime_frames.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "orbit_axis": {
          "$ref": "#/$defs/Vec3",
          "description": "Axis of `orbit_velocity`; zero means +Z (the screen plane of a 2D scene)."
        },
        "orbit_velocity": {
          "description": "Angular speed (radians per second) at which each particle's path turns around the emitter origin.",
          "format": "double",
          "type": "number"
        },
        "rotation_end": {
          "default": 0.0,
          "format": "double",
          "type": "number"
        },
        "rotation_random": {
          "description": "Each particle's rotation is offset by +/- up to this many radians.",
          "format": "double",
          "type": "number"
        },
        "rotation_start": {
          "default": 0.0,
          "format": "double",
          "type": "number"
        },
        "size_easing": {
          "$ref": "#/$defs/ParticleEasing",
          "default": "linear"
        },
        "size_end": {
          "format": "double",
          "type": "number"
        },
        "size_keys": {
          "description": "Size over life as 2-8 keys; replaces size_start/size_end/size_easing when present.",
          "items": {
            "$ref": "#/$defs/ParticleSizeKey"
          },
          "type": "array"
        },
        "size_random": {
          "description": "Each particle's size is multiplied by 1 +/- up to this fraction (0..1).",
          "format": "double",
          "type": "number"
        },
        "size_start": {
          "format": "double",
          "type": "number"
        },
        "speed_max": {
          "default": 0.0,
          "format": "double",
          "type": "number"
        },
        "speed_min": {
          "default": 0.0,
          "format": "double",
          "type": "number"
        },
        "spread": {
          "$ref": "#/$defs/Vec3",
          "default": {
            "x": 0.0,
            "y": 0.0,
            "z": 0.0
          }
        },
        "sprite_shape": {
          "$ref": "#/$defs/ParticleSpriteShape",
          "default": "soft_circle"
        },
        "start_delay_frames": {
          "default": 0,
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "texture": {
          "description": "Optional painted image for every particle of this emitter: an asset id from the project's\nasset manifest (a `texture2d`). The particle colour tints it (white keeps the painted colours),\nits alpha fades it, and size (the image height) and rotation apply as for shapes. A renderer\nwithout image particles draws `sprite_shape` instead, so keep a fitting silhouette there.",
          "type": [
            "string",
            "null"
          ]
        },
        "texture_frames": {
          "anyOf": [
            {
              "$ref": "#/$defs/ParticleTextureFrames"
            },
            {
              "type": "null"
            }
          ],
          "description": "Flipbook cells of `texture`."
        },
        "velocity_max": {
          "$ref": "#/$defs/Vec3",
          "default": {
            "x": 0.0,
            "y": 0.0,
            "z": 0.0
          }
        },
        "velocity_min": {
          "$ref": "#/$defs/Vec3",
          "default": {
            "x": 0.0,
            "y": 0.0,
            "z": 0.0
          }
        },
        "velocity_mode": {
          "$ref": "#/$defs/ParticleVelocityMode",
          "default": "vector"
        }
      },
      "required": [
        "id",
        "count",
        "interval_frames",
        "lifetime_frames",
        "size_start",
        "size_end",
        "color_start",
        "color_end"
      ],
      "type": "object"
    },
    "ParticleSizeKey": {
      "additionalProperties": false,
      "description": "One point of a size curve over a particle's life (`t` 0 at birth, 1 at death).",
      "properties": {
        "size": {
          "format": "double",
          "type": "number"
        },
        "t": {
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "t",
        "size"
      ],
      "type": "object"
    },
    "ParticleSpriteShape": {
      "enum": [
        "soft_circle",
        "diamond",
        "ring",
        "streak"
      ],
      "type": "string"
    },
    "ParticleTextureFrames": {
      "additionalProperties": false,
      "description": "A sprite sheet for image particles: `columns` x `rows` equal cells read left to right, top to bottom.\n`fps` 0 plays the frames once over each particle's life; otherwise they loop at that rate.",
      "properties": {
        "columns": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "count": {
          "description": "Frames used, from the first cell; defaults to every cell.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "fps": {
          "default": 0.0,
          "format": "double",
          "type": "number"
        },
        "random_start": {
          "default": false,
          "description": "Each particle starts on a random frame.",
          "type": "boolean"
        },
        "rows": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "columns",
        "rows"
      ],
      "type": "object"
    },
    "ParticleVelocityMode": {
      "enum": [
        "vector",
        "cone",
        "radial"
      ],
      "type": "string"
    },
    "Vec3": {
      "additionalProperties": false,
      "properties": {
        "x": {
          "format": "double",
          "type": "number"
        },
        "y": {
          "format": "double",
          "type": "number"
        },
        "z": {
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y",
        "z"
      ],
      "type": "object"
    }
  },
  "$id": "https://unone.dev/schema/particle.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "duration_frames": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "emitters": {
      "items": {
        "$ref": "#/$defs/ParticleEmitter"
      },
      "type": "array"
    },
    "version": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "version",
    "duration_frames",
    "emitters"
  ],
  "title": "ParticleDefinition",
  "type": "object"
}
