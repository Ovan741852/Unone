    "schema": "unone.image-preload-independent-source-review.v1",
    "date": "2026-10-30",
    "reviewed_commit": "ab8941b494b2dfadb57b2e1747bbd0fe093dbe38",
    "reviewer": "Codex runtime audit agent, independent of the production implementation authors",
    "status": "completed-bounded-source-review",
    "remaining_concrete_p1_p2_findings": [],
    "scope": [
      "Strict image plan validator, canonical UTF-8 bounds and detached ownership",
      "Startup-first merged resource admission, required ready counters and best-effort scene classification",
      "Actual player meta/stream/UTF-8 reader, start/restart required preparation barriers and cancellation",
      "SDK-owned offline publisher, trusted validator, project/export identity and fresh generation sealing",
      "Independent entry regressions in web/shared/image-preload-entry.test.mjs"
    ],
    "resolved_findings": [
      {
        "problem": "The original plan reader retained one cloned Uint8Array per incoming chunk, allowing unbounded metadata relative to its one-MiB byte cap.",
        "resolution": "One fixed one-MiB buffer with checked offsets; finely fragmented actual-reader regression passes."
      },
      {
        "problem": "Publisher config matching rejected the officially omitted ui_previews[].save_fixture field.",
        "resolution": "ProjectConfig comparison projects only the known tool-only field and explicit empty-map serde omissions. Other authored data remains checked."
      },
      {
        "problem": "Publisher checked main_scene existence but not its contents.",
        "resolution": "Complete parsed scene values now use isDeepStrictEqual; object-key order does not affect equivalence."
      },
      {
        "problem": "Publisher read the entire raw plan before applying its one-MiB size check.",
        "resolution": "Bounded file-descriptor read with pre-allocation stat cap, at most cap-plus-one bytes and size recheck."
      },
      {
        "problem": "Publisher could deliver a required non-PNG image even though the official bounded preloader cannot admit its dimensions.",
        "resolution": "Required unknown/non-PNG dimensions fail explicit startup preflight; non-startup groups retain ordinary supported encodings."
      },
      {
        "problem": "Publisher ignored valid unquoted existing HTML meta attributes and could emit duplicate plan declarations.",
        "resolution": "Quoted and unquoted attributes are recognized; conflicting/duplicate declarations reject instead of creating a non-launchable output."
      }
    ],
    "final_source_checks": [
      "All groups are validated, including groups outside startup; prototype-sensitive names are own data properties.",
      "Explicit startup IDs are deduplicated ahead of scene sprites under one planned decoded-image budget, separate from unused/GPU budgets.",
      "Only decoded ready required leases increment required_ready_entries. Start and restart reject cancelled or incomplete required groups before Core load/READY.",
      "Absent or empty explicit startup requirements allow best-effort scene-only partial preparation.",
      "Input export hashes and alias pairs are verified; project script/config/assets and full scene identity are checked.",
      "Publisher never imports the input export module, preserves other logical bytes and uses the Rust tuple plus UTF-8 byte ordering for a fresh release.",
      "Stale old release names from legacy finalizers are disclosed; fresh output is resealed, export.json is written last, and existing exports are never overwritten/deleted."
    ],
