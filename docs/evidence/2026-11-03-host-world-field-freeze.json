    {
      "name": "keys",
      "design": "Fresh JSON.parse only; dense array indices; Object.keys own records; freeze after discovering children. Private publication grant/epochs unchanged.",
      "tradeoff": "Allocates an Object.keys array per record; does not avoid JSON.parse allocation."
    },
    {
      "name": "guarded",
      "design": "Captured parse/freeze/isArray/hasOwn; after parse mark inspect Object.prototype enumerables once. Dense array indices; record for-in skips hasOwn only when clean, otherwise checks own keys. No external callback during traversal; freeze before publishing.",
      "tradeoff": "No explicit Object.keys arrays. Still performs complete JSON parse and freezes every owned container; no subrecord reuse or reduced-GC promise."
    }
