  "scope": "VM readonly-buffer, genuinely bounded shared buffer views, safe host mutation, strict range conversion, direct comparisons, GC/accounting/codegen and build-dependency tracking. Concurrent asset/export/game work excluded.",
  "public_contract": {
    "functions": [
      "freeze",
      "isFrozen",
      "snapshot",
      "span",
      "equals",
      "equalsRange"
    ],
    "span": "Actual readonly buffer, independent logical bounds, O(1) metadata and flattened strong root owner; keeping a small span pins the whole root.",
    "comparison": "Immediate byte comparison on every call, mutable or frozen buffers; no string/span/hash/memo allocation or retained alias.",
    "ownership": "Guest Luau writes and checked safe Rust mlua writes reject frozen payloads. Arbitrary unsafe raw native/FFI or host WASM-linear-memory mutation is outside the guarantee."
  },
  "findings": [
    {
      "id": "IB-01",
      "status": "fixed-executed-in-new-native-tests",
      "problem": "Safe mlua write_bytes/cursor bypassed the original VM readonly flag.",
      "baseline": "Source-confirmed. Initial host test compiled but never executed due Windows App Control4551; do not call that an observed runtime RED.",
      "fix": "Vendored mlua checks readonly under the same VM lock before constructing any mutable slice; range errors remain atomic; cursor rejection preserves position."
    },
    {
      "id": "IB-02",
      "status": "fixed-executed-in-new-native-tests",
      "problem": "Snapshot accepted coercing/truncating range values and computed a signed default subtraction before validation.",
      "baseline": "Actual old WASM accepted offset/length1.5 and numeric-string0. Its tested 2^32 and2^32+1 inputs were rejected; overflow was not reproduced.",
      "fix": "Validate actual finite safe integer numbers before casts and default subtraction. Apply equivalent strict range/count rules to the standard buffer library, fastcalls and inlined native reads; write payload-value semantics unchanged."
    },
    {
      "id": "IB-03",
      "status": "implemented-executed-in-new-native-tests",
      "problem": "Pre-span runtime had no independently bounded zero-copy buffer view.",
      "fix": "Real buffer data pointer, logical length and flattened root GC edge; metadata-only allocation/free/debug size; codegen loads data pointer while bounds use logical length."
    },
    {
      "id": "IB-04",
      "status": "fixed-default-native-red-to-green",
      "problem": "cc cargo_metadata(false) plus missing C++ source dependency declaration allowed default-feature builds to reuse an older VM archive.",
      "observed_red": "Four default public tests failed at malformed ordinary buffer read while the fresh no-preview/JIT build passed.",
      "fix": "Emit cargo:rerun-if-changed for absolute vendored luau subtree; Cargo recursively watches source/header contents. R2 rebuilt Luau and passed. No cache deletion, executable renaming or OS policy bypass.",
      "limit": "A separate later C++-only edit/retrigger experiment was not run; recursive Cargo dependency semantics and the emitted source declaration were inspected."
    }
  ],
