{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unone.dev/schema/project.schema.json",
  "title": "Unone project.unone.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name"
  ],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Human-readable game project name."
    },
    "entry_script": {
      "type": "string",
      "minLength": 1,
      "default": "scripts/main.luau",
      "description": "Project-relative Luau entry script."
    },
    "main_scene": {
      "type": [
        "string",
        "null"
      ],
      "description": "Optional project-relative JSON scene file."
    },
    "test_files": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Project-relative deterministic test manifest files."
    },
    "bundle_manifest": {
      "type": [
        "string",
        "null"
      ],
      "description": "Optional project-relative generated bundle manifest."
    },
    "asset_manifest": {
      "type": [
        "string",
        "null"
      ],
      "description": "Optional project-relative version-1 asset manifest."
    },
    "systems": {
      "type": "object",
      "additionalProperties": {
        "type": "boolean"
      },
      "description": "Engine systems this game explicitly turns on or off. Anything not declared keeps the engine default; unknown ids, systems the runtime requires, and systems with no implementation are rejected. Run `game systems list` for the current set."
    },
    "ui_previews": {
      "type": "array",
      "description": "Screens `game verify` must check the layout of. Without this only the opening screen is drawn, so a broken win or lose screen passes every gate.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "Screen name, used in the verify step name."
          },
          "frames": {
            "type": "integer",
            "minimum": 0,
            "default": 1,
            "description": "Frames to run before drawing."
          },
          "seed": {
            "type": "integer",
            "minimum": 0,
            "default": 42
          },
          "input_sequence": {
            "type": "string",
            "description": "Project-relative per-frame input replay that reaches this screen."
          }
        }
      }
    }
  }
}
