{
  "$comment": "Generated from Rust deserialization types by game schema. Do not edit. Runtime semantic validators additionally check ranges, references, formats and capabilities.",
  "$defs": {
    "AnimationData": {
      "additionalProperties": false,
      "description": "Skeletal animation state an entity publishes for a host to play.\n\nThe engine stores which clip is selected and since which frame; it does not\nevaluate bones, meshes or blending. The only declared asset kind for this\ntoday is Spine, and the host owns that runtime.",
      "properties": {
        "animation": {
          "type": "string"
        },
        "asset": {
          "type": "string"
        },
        "loop": {
          "default": true,
          "type": "boolean"
        },
        "speed": {
          "default": 1.0,
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "asset",
        "animation"
      ],
      "type": "object"
    },
    "Body3D": {
      "additionalProperties": false,
      "properties": {
        "angular_damping": {
          "default": 0.0,
          "format": "double",
          "type": "number"
        },
        "angular_velocity": {
          "$ref": "#/$defs/Vec3",
          "default": {
            "x": 0.0,
            "y": 0.0,
            "z": 0.0
          }
        },
        "body_type": {
          "$ref": "#/$defs/BodyKind"
        },
        "can_sleep": {
          "default": true,
          "type": "boolean"
        },
        "ccd": {
          "default": false,
          "type": "boolean"
        },
        "filter": {
          "default": -1,
          "format": "int32",
          "type": "integer"
        },
        "friction": {
          "default": 0.5,
          "format": "double",
          "type": "number"
        },
        "gravity_scale": {
          "default": 1.0,
          "format": "double",
          "type": "number"
        },
        "linear_damping": {
          "default": 0.0,
          "format": "double",
          "type": "number"
        },
        "lock_rotation": {
          "default": false,
          "type": "boolean"
        },
        "mass": {
          "default": 1.0,
          "format": "double",
          "type": "number"
        },
        "membership": {
          "default": -1,
          "format": "int32",
          "type": "integer"
        },
        "restitution": {
          "default": 0.0,
          "format": "double",
          "type": "number"
        },
        "sensor": {
          "default": false,
          "type": "boolean"
        },
        "shape": {
          "$ref": "#/$defs/Shape3D"
        },
        "velocity": {
          "$ref": "#/$defs/Vec3",
          "default": {
            "x": 0.0,
            "y": 0.0,
            "z": 0.0
          }
        }
      },
      "required": [
        "body_type",
        "shape"
      ],
      "type": "object"
    },
    "BodyKind": {
      "enum": [
        "dynamic",
        "static",
        "kinematic"
      ],
      "type": "string"
    },
    "Camera2DData": {
      "additionalProperties": false,
      "properties": {
        "position": {
          "$ref": "#/$defs/Vec2",
          "default": {
            "x": 0.0,
            "y": 0.0
          }
        },
        "view_height": {
          "default": 10.0,
          "description": "World units visible vertically at zoom 1, centred on `position`.\n\nWithout this a host cannot know how much world a frame shows, so every\nhost invented its own constant and the same scene framed differently in\neach one. The visible height is `view_height / zoom`, and the visible\nwidth is that times the host's viewport aspect.",
          "format": "double",
          "type": "number"
        },
        "zoom": {
          "default": 1.0,
          "format": "double",
          "type": "number"
        }
      },
      "type": "object"
    },
    "Camera3DData": {
      "additionalProperties": false,
      "properties": {
        "curvature": {
          "description": "Bends world geometry around the target point: in view space relative to\nthe target, y -= curvature * (x^2 + z^2). 0 disables it.",
          "format": "double",
          "type": "number"
        },
        "fov_degrees": {
          "default": 60.0,
          "format": "double",
          "type": "number"
        },
        "handedness": {
          "$ref": "#/$defs/CameraHandedness",
          "description": "How world coordinates map to the screen. `left` keeps x right, y up and\nz away from the viewer at identity, as in Direct3D and Unity."
        },
        "position": {
          "$ref": "#/$defs/Vec3",
          "default": {
            "x": 0.0,
            "y": 3.0,
            "z": 8.0
          }
        },
        "rect": {
          "anyOf": [
            {
              "$ref": "#/$defs/CameraRect"
            },
            {
              "type": "null"
            }
          ],
          "description": "Normalized viewport (lower-left origin) the view renders into; None is\nthe whole surface."
        },
        "target": {
          "$ref": "#/$defs/Vec3",
          "default": {
            "x": 0.0,
            "y": 0.0,
            "z": 0.0
          }
        }
      },
      "type": "object"
    },
    "CameraHandedness": {
      "enum": [
        "right",
        "left"
      ],
      "type": "string"
    },
    "CameraRect": {
      "additionalProperties": false,
      "properties": {
        "height": {
          "format": "double",
          "type": "number"
        },
        "width": {
          "format": "double",
          "type": "number"
        },
        "x": {
          "format": "double",
          "type": "number"
        },
        "y": {
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "type": "object"
    },
    "Mesh3DData": {
      "additionalProperties": false,
      "properties": {
        "asset": {
          "type": "string"
        },
        "visible": {
          "default": true,
          "type": "boolean"
        }
      },
      "required": [
        "asset"
      ],
      "type": "object"
    },
    "ParticleDefinition": {
      "additionalProperties": false,
      "properties": {
        "duration_frames": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "emitters": {
          "items": {
            "$ref": "#/$defs/ParticleEmitter"
          },
          "type": "array"
        },
        "version": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "version",
        "duration_frames",
        "emitters"
      ],
      "type": "object"
    },
    "ParticleEasing": {
      "enum": [
        "linear",
        "ease_in",
        "ease_out",
        "smooth_step"
      ],
      "type": "string"
    },
    "ParticleEmissionShape": {
      "enum": [
        "point",
        "box",
        "sphere",
        "ring"
      ],
      "type": "string"
    },
    "ParticleEmitter": {
      "additionalProperties": false,
      "properties": {
        "additive": {
          "default": false,
          "type": "boolean"
        },
        "angular_velocity": {
          "default": 0.0,
          "format": "double",
          "type": "number"
        },
        "color_easing": {
          "$ref": "#/$defs/ParticleEasing",
          "default": "linear"
        },
        "color_end": {
          "items": {
            "format": "double",
            "type": "number"
          },
          "maxItems": 4,
          "minItems": 4,
          "type": "array"
        },
        "color_start": {
          "items": {
            "format": "double",
            "type": "number"
          },
          "maxItems": 4,
          "minItems": 4,
          "type": "array"
        },
        "cone_angle_degrees": {
          "default": 0.0,
          "format": "double",
          "type": "number"
        },
        "count": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "direction": {
          "$ref": "#/$defs/Vec3",
          "default": {
            "x": 0.0,
            "y": 0.0,
            "z": 0.0
          }
        },
        "emission_radius": {
          "default": 0.0,
          "format": "double",
          "type": "number"
        },
        "emission_shape": {
          "$ref": "#/$defs/ParticleEmissionShape",
          "default": "box"
        },
        "gravity": {
          "$ref": "#/$defs/Vec3",
          "default": {
            "x": 0.0,
            "y": 0.0,
            "z": 0.0
          }
        },
        "id": {
          "type": "string"
        },
        "interval_frames": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "lifetime_frames": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "rotation_end": {
          "default": 0.0,
          "format": "double",
          "type": "number"
        },
        "rotation_start": {
          "default": 0.0,
          "format": "double",
          "type": "number"
        },
        "size_easing": {
          "$ref": "#/$defs/ParticleEasing",
          "default": "linear"
        },
        "size_end": {
          "format": "double",
          "type": "number"
        },
        "size_start": {
          "format": "double",
          "type": "number"
        },
        "speed_max": {
          "default": 0.0,
          "format": "double",
          "type": "number"
        },
        "speed_min": {
          "default": 0.0,
          "format": "double",
          "type": "number"
        },
        "spread": {
          "$ref": "#/$defs/Vec3",
          "default": {
            "x": 0.0,
            "y": 0.0,
            "z": 0.0
          }
        },
        "sprite_shape": {
          "$ref": "#/$defs/ParticleSpriteShape",
          "default": "soft_circle"
        },
        "start_delay_frames": {
          "default": 0,
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "velocity_max": {
          "$ref": "#/$defs/Vec3",
          "default": {
            "x": 0.0,
            "y": 0.0,
            "z": 0.0
          }
        },
        "velocity_min": {
          "$ref": "#/$defs/Vec3",
          "default": {
            "x": 0.0,
            "y": 0.0,
            "z": 0.0
          }
        },
        "velocity_mode": {
          "$ref": "#/$defs/ParticleVelocityMode",
          "default": "vector"
        }
      },
      "required": [
        "id",
        "count",
        "interval_frames",
        "lifetime_frames",
        "size_start",
        "size_end",
        "color_start",
        "color_end"
      ],
      "type": "object"
    },
    "ParticleSpriteShape": {
      "enum": [
        "soft_circle",
        "diamond",
        "ring",
        "streak"
      ],
      "type": "string"
    },
    "ParticleVelocityMode": {
      "enum": [
        "vector",
        "cone",
        "radial"
      ],
      "type": "string"
    },
    "Physics3DScene": {
      "additionalProperties": false,
      "properties": {
        "bodies": {
          "additionalProperties": {
            "$ref": "#/$defs/Body3D"
          },
          "default": {},
          "type": "object"
        },
        "gravity": {
          "$ref": "#/$defs/Vec3",
          "default": {
            "x": 0.0,
            "y": -9.81,
            "z": 0.0
          }
        }
      },
      "type": "object"
    },
    "PhysicsSettings": {
      "additionalProperties": false,
      "properties": {
        "gravity": {
          "$ref": "#/$defs/Vec2",
          "default": {
            "x": 0.0,
            "y": -9.8
          }
        },
        "ground_friction": {
          "default": 0.0,
          "description": "Horizontal velocity lost per second while a body rests on the ground.\n\nWithout it a landed body slides the length of the level, which silently\nturns a miss into a hit.",
          "format": "double",
          "type": "number"
        },
        "ground_y": {
          "default": null,
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "linear_damping": {
          "default": 0.0,
          "description": "Velocity lost per second by every dynamic body, as a fraction.\n\nDefaults to none, which is what this engine simulated before the field\nexisted: a body keeps its velocity forever unless something takes it.",
          "format": "double",
          "type": "number"
        }
      },
      "type": "object"
    },
    "RigidBody2DData": {
      "additionalProperties": false,
      "properties": {
        "body_type": {
          "$ref": "#/$defs/RigidBodyType",
          "default": "dynamic"
        },
        "mass": {
          "default": 1.0,
          "format": "double",
          "type": "number"
        },
        "radius": {
          "default": 0.5,
          "format": "double",
          "type": "number"
        },
        "restitution": {
          "default": 0.0,
          "format": "double",
          "type": "number"
        },
        "velocity": {
          "$ref": "#/$defs/Vec2",
          "default": {
            "x": 0.0,
            "y": 0.0
          }
        }
      },
      "type": "object"
    },
    "RigidBodyType": {
      "enum": [
        "dynamic",
        "static"
      ],
      "type": "string"
    },
    "SceneEntity": {
      "additionalProperties": false,
      "properties": {
        "animation": {
          "anyOf": [
            {
              "$ref": "#/$defs/AnimationData"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "id": {
          "type": "string"
        },
        "mesh3d": {
          "anyOf": [
            {
              "$ref": "#/$defs/Mesh3DData"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "name": {
          "default": "",
          "type": "string"
        },
        "rigidbody": {
          "anyOf": [
            {
              "$ref": "#/$defs/RigidBody2DData"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "rotation": {
          "default": 0.0,
          "description": "Visual-only 2D rotation in radians around the sprite centre.",
          "format": "double",
          "type": "number"
        },
        "scale": {
          "$ref": "#/$defs/Vec2",
          "default": {
            "x": 1.0,
            "y": 1.0
          },
          "description": "Visual-only 2D scale applied to the sprite's declared size."
        },
        "shader_material": {
          "type": [
            "string",
            "null"
          ]
        },
        "sprite": {
          "anyOf": [
            {
              "$ref": "#/$defs/SpriteData"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "sprite_animation": {
          "anyOf": [
            {
              "$ref": "#/$defs/SpriteAnimationData"
            },
            {
              "type": "null"
            }
          ],
          "description": "Fixed-tick frame animation over the sprite's sheet cells."
        },
        "transform": {
          "$ref": "#/$defs/Vec2",
          "default": {
            "x": 0.0,
            "y": 0.0
          }
        },
        "transform3d": {
          "anyOf": [
            {
              "$ref": "#/$defs/Transform3DData"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id"
      ],
      "type": "object"
    },
    "ShaderMaterialDefinition": {
      "additionalProperties": false,
      "properties": {
        "fragment": {
          "description": "GLSL ES 1.00 function: vec4 unoneShade(vec2 uv, vec4 color).",
          "type": "string"
        },
        "uniforms": {
          "additionalProperties": {
            "$ref": "#/$defs/ShaderUniform"
          },
          "default": {},
          "type": "object"
        }
      },
      "required": [
        "fragment"
      ],
      "type": "object"
    },
    "ShaderUniform": {
      "anyOf": [
        {
          "format": "double",
          "type": "number"
        },
        {
          "items": {
            "format": "double",
            "type": "number"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        },
        {
          "items": {
            "format": "double",
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "type": "array"
        },
        {
          "items": {
            "format": "double",
            "type": "number"
          },
          "maxItems": 4,
          "minItems": 4,
          "type": "array"
        }
      ]
    },
    "Shape3D": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "sphere",
              "type": "string"
            },
            "radius": {
              "format": "double",
              "type": "number"
            }
          },
          "required": [
            "kind",
            "radius"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "half_extents": {
              "$ref": "#/$defs/Vec3"
            },
            "kind": {
              "const": "box",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "half_extents"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "half_height": {
              "format": "double",
              "type": "number"
            },
            "kind": {
              "const": "capsule",
              "type": "string"
            },
            "radius": {
              "format": "double",
              "type": "number"
            }
          },
          "required": [
            "kind",
            "half_height",
            "radius"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "convex",
              "type": "string"
            },
            "vertices": {
              "items": {
                "$ref": "#/$defs/Vec3"
              },
              "type": "array"
            }
          },
          "required": [
            "kind",
            "vertices"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "indices": {
              "items": {
                "items": {
                  "format": "uint32",
                  "minimum": 0,
                  "type": "integer"
                },
                "maxItems": 3,
                "minItems": 3,
                "type": "array"
              },
              "type": "array"
            },
            "kind": {
              "const": "trimesh",
              "type": "string"
            },
            "vertices": {
              "items": {
                "$ref": "#/$defs/Vec3"
              },
              "type": "array"
            }
          },
          "required": [
            "kind",
            "vertices",
            "indices"
          ],
          "type": "object"
        }
      ]
    },
    "SpriteAnimationData": {
      "additionalProperties": false,
      "description": "A clip of sprite sheet cells the engine steps on the fixed tick.\n\nThe engine resolves the current cell into `sprite.frame` every observation,\nso hosts only map a cell to texture coordinates and replays stay exact.",
      "properties": {
        "fps": {
          "description": "Cells per second of fixed-tick time.",
          "format": "double",
          "type": "number"
        },
        "frames": {
          "description": "Sheet cells in play order, numbered from 0 left to right, then top to\nbottom. A cell may repeat to hold it longer.",
          "items": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "type": "array"
        },
        "loop": {
          "default": true,
          "type": "boolean"
        }
      },
      "required": [
        "frames",
        "fps"
      ],
      "type": "object"
    },
    "SpriteData": {
      "additionalProperties": false,
      "properties": {
        "asset": {
          "type": "string"
        },
        "frame": {
          "description": "Sheet cell to draw, numbered from 0 left to right, then top to bottom.\nWhile a sprite animation plays, observations carry its current cell.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "layer": {
          "default": 0,
          "description": "Painter layer. Lower layers are drawn first; same-layer order is the\nascending entity id, which is the portable tie-break used by hosts.",
          "format": "int32",
          "type": "integer"
        },
        "sheet": {
          "anyOf": [
            {
              "$ref": "#/$defs/SpriteSheet"
            },
            {
              "type": "null"
            }
          ],
          "description": "Splits the texture into equal cells so the sprite draws one of them."
        },
        "size": {
          "$ref": "#/$defs/Vec2",
          "default": {
            "x": 1.0,
            "y": 1.0
          }
        },
        "visible": {
          "default": true,
          "type": "boolean"
        }
      },
      "required": [
        "asset"
      ],
      "type": "object"
    },
    "SpriteSheet": {
      "additionalProperties": false,
      "description": "A grid of equally sized cells covering the whole texture.",
      "properties": {
        "columns": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "rows": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "columns",
        "rows"
      ],
      "type": "object"
    },
    "Transform3DData": {
      "additionalProperties": false,
      "properties": {
        "position": {
          "$ref": "#/$defs/Vec3",
          "default": {
            "x": 0.0,
            "y": 0.0,
            "z": 0.0
          }
        },
        "rotation": {
          "$ref": "#/$defs/Vec3",
          "default": {
            "x": 0.0,
            "y": 0.0,
            "z": 0.0
          },
          "description": "Euler rotation in radians. The engine stores the transform; game code\nowns the meaning of steering and other gameplay-specific orientation."
        },
        "scale": {
          "$ref": "#/$defs/Vec3",
          "default": {
            "x": 1.0,
            "y": 1.0,
            "z": 1.0
          }
        }
      },
      "type": "object"
    },
    "Vec2": {
      "additionalProperties": false,
      "properties": {
        "x": {
          "format": "double",
          "type": "number"
        },
        "y": {
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "type": "object"
    },
    "Vec3": {
      "additionalProperties": false,
      "properties": {
        "x": {
          "format": "double",
          "type": "number"
        },
        "y": {
          "format": "double",
          "type": "number"
        },
        "z": {
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y",
        "z"
      ],
      "type": "object"
    }
  },
  "$id": "https://unone.dev/schema/scene.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
