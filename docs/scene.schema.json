{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unone.dev/schema/scene.schema.json",
  "title": "Unone scene JSON",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "entities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entity"
      }
    },
    "physics": {
      "$ref": "#/$defs/physics"
    },
    "camera": {
      "$ref": "#/$defs/camera2d"
    },
    "camera3d": {
      "anyOf": [
        {
          "$ref": "#/$defs/camera3d"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "$defs": {
    "vec2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      }
    },
    "scale2d": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y"
      ],
      "properties": {
        "x": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "y": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "description": "Visual-only 2D scale. It does not change RigidBody2D parameters or collision resolution."
    },
    "vec3": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "z"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "z": {
          "type": "number"
        }
      }
    },
    "transform3d": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "position": {
          "$ref": "#/$defs/vec3"
        },
        "rotation": {
          "$ref": "#/$defs/vec3"
        },
        "scale": {
          "$ref": "#/$defs/vec3"
        }
      }
    },
    "sprite": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset"
      ],
      "properties": {
        "asset": {
          "type": "string",
          "minLength": 1
        },
        "size": {
          "$ref": "#/$defs/vec2"
        },
        "visible": {
          "type": "boolean"
        },
        "layer": {
          "type": "integer",
          "minimum": -2147483648,
          "maximum": 2147483647,
          "default": 0,
          "description": "Signed portable 32-bit painter layer. Lower layers draw first. Same-layer order is ascending entity id."
        }
      }
    },
    "mesh3d": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset"
      ],
      "properties": {
        "asset": {
          "type": "string",
          "minLength": 1
        },
        "visible": {
          "type": "boolean"
        }
      }
    },
    "rigidbody": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "body_type": {
          "enum": [
            "dynamic",
            "static"
          ]
        },
        "mass": {
          "type": "number"
        },
        "radius": {
          "type": "number"
        },
        "velocity": {
          "$ref": "#/$defs/vec2"
        },
        "restitution": {
          "type": "number"
        }
      }
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string"
        },
        "transform": {
          "$ref": "#/$defs/vec2"
        },
        "rotation": {
          "type": "number",
          "default": 0,
          "description": "Visual-only 2D rotation in radians, positive counter-clockwise in the y-up world, around the entity centre. It does not affect collision."
        },
        "scale": {
          "$ref": "#/$defs/scale2d",
          "default": {
            "x": 1,
            "y": 1
          }
        },
        "transform3d": {
          "anyOf": [
            {
              "$ref": "#/$defs/transform3d"
            },
            {
              "type": "null"
            }
          ]
        },
        "sprite": {
          "anyOf": [
            {
              "$ref": "#/$defs/sprite"
            },
            {
              "type": "null"
            }
          ]
        },
        "mesh3d": {
          "anyOf": [
            {
              "$ref": "#/$defs/mesh3d"
            },
            {
              "type": "null"
            }
          ]
        },
        "rigidbody": {
          "anyOf": [
            {
              "$ref": "#/$defs/rigidbody"
            },
            {
              "type": "null"
            }
          ]
        },
        "animation": {
          "anyOf": [
            {
              "$ref": "#/$defs/animation"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "physics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "gravity": {
          "$ref": "#/$defs/vec2"
        },
        "ground_y": {
          "type": [
            "number",
            "null"
          ]
        },
        "linear_damping": {
          "type": "number",
          "minimum": 0,
          "default": 0,
          "description": "Fraction of velocity every dynamic body loses per second. 0 means a body keeps its velocity forever."
        },
        "ground_friction": {
          "type": "number",
          "minimum": 0,
          "default": 0,
          "description": "Fraction of horizontal velocity a body loses per second while resting on the ground. 0 means a landed body slides forever."
        }
      }
    },
    "camera2d": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "position": {
          "$ref": "#/$defs/vec2"
        },
        "zoom": {
          "type": "number"
        },
        "view_height": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 10,
          "description": "World units visible vertically at zoom 1, centred on position. Visible height is view_height/zoom; visible width is that times the host viewport aspect."
        }
      }
    },
    "camera3d": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "position": {
          "$ref": "#/$defs/vec3"
        },
        "target": {
          "$ref": "#/$defs/vec3"
        },
        "fov_degrees": {
          "type": "number"
        }
      }
    },
    "animation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset",
        "animation"
      ],
      "properties": {
        "asset": {
          "type": "string",
          "minLength": 1,
          "description": "Skeletal animation asset id declared in the asset manifest."
        },
        "animation": {
          "type": "string",
          "minLength": 1,
          "description": "Clip name defined by the asset."
        },
        "loop": {
          "type": "boolean",
          "default": true
        },
        "speed": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 1
        }
      }
    }
  }
}
