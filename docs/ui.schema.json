{
  "$comment": "Generated from Rust deserialization types by game schema. Do not edit. Runtime semantic validators additionally check ranges, references, formats and capabilities.",
  "$defs": {
    "RawOffset": {
      "additionalProperties": false,
      "description": "Anchored offsets and sizes are in vertical units: percent of the viewport\nheight, on both axes. One unit system means an author never has to reason\nabout the aspect, and a box keeps its shape when the aspect changes.",
      "properties": {
        "x": {
          "default": 0.0,
          "format": "double",
          "type": "number"
        },
        "y": {
          "default": 0.0,
          "format": "double",
          "type": "number"
        }
      },
      "type": "object"
    },
    "RawSize": {
      "additionalProperties": false,
      "properties": {
        "height": {
          "format": "double",
          "type": "number"
        },
        "width": {
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "width",
        "height"
      ],
      "type": "object"
    },
    "RawUiNode": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "alt": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "anchor": {
          "anyOf": [
            {
              "$ref": "#/$defs/UiAnchor"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Edge-relative placement, resolved by the engine against the host's real\nviewport shape so a screen keeps its proportions on any aspect."
        },
        "asset": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "background_for": {
          "anyOf": [
            {
              "$ref": "#/$defs/UiBackgroundScope"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "children": {
          "items": {
            "$ref": "#/$defs/RawUiNode"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "component": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "drag": {
          "anyOf": [
            {
              "$ref": "#/$defs/UiSliderDrag"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "expanded": {
          "default": null,
          "type": [
            "boolean",
            "null"
          ]
        },
        "fit": {
          "anyOf": [
            {
              "$ref": "#/$defs/UiImageFit"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "offset": {
          "anyOf": [
            {
              "$ref": "#/$defs/RawOffset"
            },
            {
              "type": "null"
            }
          ]
        },
        "pivot": {
          "anyOf": [
            {
              "$ref": "#/$defs/UiAnchor"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "rect": {
          "anyOf": [
            {
              "$ref": "#/$defs/UiRect"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Absolute placement in the design space. Use it when the layout is not\nedge relative, such as a ring laid out with trigonometry."
        },
        "scroll": {
          "anyOf": [
            {
              "$ref": "#/$defs/UiScroll"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "size": {
          "anyOf": [
            {
              "$ref": "#/$defs/RawSize"
            },
            {
              "type": "null"
            }
          ]
        },
        "slice": {
          "anyOf": [
            {
              "$ref": "#/$defs/UiSlice"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "style": {
          "anyOf": [
            {
              "$ref": "#/$defs/UiStyle"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "text": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "viewport": {
          "anyOf": [
            {
              "$ref": "#/$defs/UiViewport"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "type": "object"
    },
    "UiAnchor": {
      "description": "Where an anchored node hangs from, and which of its own corners it hangs by.\n\nA named corner is the whole point: an author who cannot see the screen picks\na word correctly far more often than four normalized floats, which is what\nevery RectTransform-style anchor system asks for.",
      "enum": [
        "top_left",
        "top",
        "top_right",
        "left",
        "center",
        "right",
        "bottom_left",
        "bottom",
        "bottom_right"
      ],
      "type": "string"
    },
    "UiBackgroundScope": {
      "anyOf": [
        {
          "additionalProperties": false,
          "properties": {
            "screen": {
              "const": true,
              "type": "boolean"
            }
          },
          "required": [
            "screen"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "component": {
              "type": "string"
            }
          },
          "required": [
            "component"
          ],
          "type": "object"
        }
      ],
      "description": "Explicit decorative ownership for overlap diagnostics. This declares intent;\nit does not change coordinates, paint order, input or component styles."
    },
    "UiBudget": {
      "additionalProperties": false,
      "properties": {
        "max_nodes": {
          "format": "uint",
          "maximum": 16384,
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "max_nodes"
      ],
      "type": "object"
    },
    "UiImageFit": {
      "enum": [
        "contain",
        "cover",
        "stretch"
      ],
      "type": "string"
    },
    "UiInsets": {
      "additionalProperties": false,
      "description": "Shared UI styling uses vertical design units (one unit is 1% of viewport\nheight), including horizontal padding and letter spacing. Styles are local\nto one leaf: components do not create implicit style inheritance.",
      "properties": {
        "bottom": {
          "default": 0.0,
          "format": "double",
          "maximum": 100,
          "minimum": 0,
          "type": "number"
        },
        "left": {
          "default": 0.0,
          "format": "double",
          "maximum": 100,
          "minimum": 0,
          "type": "number"
        },
        "right": {
          "default": 0.0,
          "format": "double",
          "maximum": 100,
          "minimum": 0,
          "type": "number"
        },
        "top": {
          "default": 0.0,
          "format": "double",
          "maximum": 100,
          "minimum": 0,
          "type": "number"
        }
      },
      "type": "object"
    },
    "UiRect": {
      "additionalProperties": false,
      "description": "Logical coordinates for a host-rendered UI element.\n\nBoth axes run 0..100 and **y points up**: y = 0 is the bottom of the screen\nand a rect grows upward from its y. Most UI systems are y-down, so this is\nthe easiest thing for an author who cannot see the screen to get wrong.\n\nThe platform host maps this design space to its viewport. The engine does\nnot know about pixels, DPI, safe areas, fonts, or platform widgets.",
      "properties": {
        "height": {
          "format": "double",
          "type": "number"
        },
        "width": {
          "format": "double",
          "type": "number"
        },
        "x": {
          "format": "double",
          "type": "number"
        },
        "y": {
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "type": "object"
    },
    "UiScroll": {
      "additionalProperties": false,
      "description": "Scroll content is local, top-left, y-down, in the same axis units as rect.\nOnly the viewport uses the containing space. No implicit flow layout.",
      "properties": {
        "axis": {
          "default": "vertical",
          "type": "string"
        },
        "deceleration": {
          "default": 8.0,
          "description": "Exponential velocity decay per second, in (0, 100].",
          "format": "double",
          "type": "number"
        },
        "enabled": {
          "default": true,
          "type": "boolean"
        },
        "inertia": {
          "default": false,
          "description": "Presentation-only drag momentum; opt in without changing simulation.",
          "type": "boolean"
        },
        "reset_key": {
          "default": "",
          "type": "string"
        },
        "virtual_items": {
          "anyOf": [
            {
              "$ref": "#/$defs/UiVirtualItems"
            },
            {
              "type": "null"
            }
          ]
        },
        "wheel_rect": {
          "anyOf": [
            {
              "$ref": "#/$defs/UiRect"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "type": "object"
    },
    "UiSlice": {
      "additionalProperties": false,
      "description": "Source borders are pixels; pixels_per_unit converts them to vertical design\nunits (one unit = 1% of viewport height). This preserves corners across DPI\nand aspect ratios. Source is an optional atlas/trim region, in source pixels.",
      "properties": {
        "bottom": {
          "format": "double",
          "type": "number"
        },
        "left": {
          "format": "double",
          "type": "number"
        },
        "pixels_per_unit": {
          "format": "double",
          "type": "number"
        },
        "right": {
          "format": "double",
          "type": "number"
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/UiRect"
            },
            {
              "type": "null"
            }
          ]
        },
        "top": {
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "left",
        "top",
        "right",
        "bottom",
        "pixels_per_unit"
      ],
      "type": "object"
    },
    "UiSliderAxis": {
      "enum": [
        "horizontal",
        "vertical"
      ],
      "type": "string"
    },
    "UiSliderDrag": {
      "additionalProperties": false,
      "description": "Official slider gesture geometry in the same space as its node: stage\ny-up, or scroll-local top-left/y-down before host projection. Hosts map\ntrack coordinates to a clamped ratio and apply reverse exactly once.",
      "properties": {
        "axis": {
          "$ref": "#/$defs/UiSliderAxis",
          "default": "horizontal"
        },
        "enabled": {
          "default": true,
          "type": "boolean"
        },
        "hit_rect": {
          "$ref": "#/$defs/UiRect"
        },
        "reverse": {
          "default": false,
          "type": "boolean"
        },
        "track_rect": {
          "$ref": "#/$defs/UiRect"
        }
      },
      "required": [
        "track_rect",
        "hit_rect"
      ],
      "type": "object"
    },
    "UiStyle": {
      "additionalProperties": false,
      "description": "Platform-neutral style data. Fonts name installed host families, not files\nor URLs. An explicit font_size is never inferred from the node's box and is\nnever silently shrunk to fit it. A styled text leaf defaults to font_size=2,\nweight=400, line_height=1.2, centered/middle, no-wrap and clipped overflow.\nAbsence of the entire style object preserves the legacy presentation path.",
      "properties": {
        "background": {
          "items": {
            "format": "double",
            "maximum": 1,
            "minimum": 0,
            "type": "number"
          },
          "maxItems": 4,
          "minItems": 4,
          "type": [
            "array",
            "null"
          ]
        },
        "border_color": {
          "items": {
            "format": "double",
            "maximum": 1,
            "minimum": 0,
            "type": "number"
          },
          "maxItems": 4,
          "minItems": 4,
          "type": [
            "array",
            "null"
          ]
        },
        "border_radius": {
          "format": "double",
          "maximum": 100,
          "minimum": 0,
          "type": [
            "number",
            "null"
          ]
        },
        "border_width": {
          "format": "double",
          "maximum": 100,
          "minimum": 0,
          "type": [
            "number",
            "null"
          ]
        },
        "color": {
          "items": {
            "format": "double",
            "maximum": 1,
            "minimum": 0,
            "type": "number"
          },
          "maxItems": 4,
          "minItems": 4,
          "type": [
            "array",
            "null"
          ]
        },
        "font_family": {
          "maxLength": 256,
          "minLength": 1,
          "type": [
            "string",
            "null"
          ]
        },
        "font_size": {
          "exclusiveMinimum": 0,
          "format": "double",
          "maximum": 100,
          "type": [
            "number",
            "null"
          ]
        },
        "font_weight": {
          "format": "uint16",
          "maximum": 900.0,
          "minimum": 100.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "letter_spacing": {
          "format": "double",
          "maximum": 10.0,
          "minimum": -10.0,
          "type": [
            "number",
            "null"
          ]
        },
        "line_height": {
          "format": "double",
          "maximum": 4.0,
          "minimum": 0.5,
          "type": [
            "number",
            "null"
          ]
        },
        "opacity": {
          "format": "double",
          "maximum": 1.0,
          "minimum": 0.0,
          "type": [
            "number",
            "null"
          ]
        },
        "overflow": {
          "anyOf": [
            {
              "$ref": "#/$defs/UiTextOverflow"
            },
            {
              "type": "null"
            }
          ]
        },
        "padding": {
          "anyOf": [
            {
              "$ref": "#/$defs/UiInsets"
            },
            {
              "type": "null"
            }
          ]
        },
        "text_align": {
          "anyOf": [
            {
              "$ref": "#/$defs/UiTextAlign"
            },
            {
              "type": "null"
            }
          ]
        },
        "vertical_align": {
          "anyOf": [
            {
              "$ref": "#/$defs/UiVerticalAlign"
            },
            {
              "type": "null"
            }
          ]
        },
        "wrap": {
          "anyOf": [
            {
              "$ref": "#/$defs/UiTextWrap"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "type": "object"
    },
    "UiTextAlign": {
      "enum": [
        "start",
        "center",
        "end"
      ],
      "type": "string"
    },
    "UiTextOverflow": {
      "enum": [
        "clip",
        "ellipsis"
      ],
      "type": "string"
    },
    "UiTextWrap": {
      "enum": [
        "none",
        "word"
      ],
      "type": "string"
    },
    "UiVerticalAlign": {
      "enum": [
        "top",
        "middle",
        "bottom"
      ],
      "type": "string"
    },
    "UiViewport": {
      "additionalProperties": false,
      "properties": {
        "height": {
          "format": "double",
          "type": "number"
        },
        "left": {
          "format": "double",
          "type": "number"
        },
        "top": {
          "format": "double",
          "type": "number"
        },
        "width": {
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "left",
        "top",
        "width",
        "height"
      ],
      "type": "object"
    },
    "UiVirtualItems": {
      "additionalProperties": false,
      "properties": {
        "column_width": {
          "format": "double",
          "type": "number"
        },
        "columns": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "first": {
          "description": "Inclusive, one-based materialized range. Empty data uses (0, 0).",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "gap_x": {
          "format": "double",
          "type": "number"
        },
        "gap_y": {
          "format": "double",
          "type": "number"
        },
        "keys": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "last": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "revision": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "row_height": {
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "keys",
        "row_height",
        "column_width",
        "columns",
        "gap_x",
        "gap_y",
        "revision",
        "first",
        "last"
      ],
      "type": "object"
    }
  },
  "$id": "https://unone.dev/schema/ui.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "budget": {
      "anyOf": [
        {
          "$ref": "#/$defs/UiBudget"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "children": {
      "items": {
        "$ref": "#/$defs/RawUiNode"
      },
      "maxItems": 16384,
      "type": "array"
    },
    "id": {
      "type": "string"
    },
    "kind": {
      "type": "string"
    },
    "node": {
      "type": "string"
    }
  },
  "required": [
    "kind",
    "id",
    "node",
    "children"
  ],
  "title": "RawUiTree",
  "type": "object",
  "x-unone-ui-contract": {
    "default_max_nodes": 2048,
    "host_max_nodes": 16384,
    "max_component_depth": 16,
    "max_layout_comparisons": 1000000,
    "max_layout_findings": 1024,
    "max_string_bytes": 8388608,
    "version": 3
  }
}
