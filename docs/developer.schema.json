    "Transform2DData": {
      "additionalProperties": false,
      "description": "The typed 2D transform exposed to Luau.\n\nScene and snapshot JSON keep `Entity.transform` as the existing `{x, y}`\nposition and store `rotation`/`scale` as additive sibling fields. The\naggregate is only the API shape, so existing position-only scripts keep\ntheir current data path.",
      "properties": {
        "position": {
          "$ref": "#/$defs/Vec2",
          "default": {
            "x": 0.0,
            "y": 0.0
          }
        },
        "rotation": {
          "default": 0.0,
          "description": "Visual Euler rotation in radians. Positive rotation is\ncounter-clockwise in the engine's y-up world.",
          "format": "double",
          "type": "number"
        },
        "scale": {
          "$ref": "#/$defs/Vec2",
          "default": {
            "x": 1.0,
            "y": 1.0
          },
          "description": "Visual scale. Both components must be finite and strictly positive;\nmirroring through negative scale is not part of this contract."
        }
      },
      "type": "object"
    },
    "Transform3DData": {
      "additionalProperties": false,
      "properties": {
        "position": {
          "$ref": "#/$defs/Vec3",
          "default": {
            "x": 0.0,
            "y": 0.0,
            "z": 0.0
          }
        },
        "rotation": {
          "$ref": "#/$defs/Vec3",
          "default": {
            "x": 0.0,
            "y": 0.0,
            "z": 0.0
          },
          "description": "Euler rotation in radians. The engine stores the transform; game code\nowns the meaning of steering and other gameplay-specific orientation."
        },
        "scale": {
          "$ref": "#/$defs/Vec3",
          "default": {
            "x": 1.0,
            "y": 1.0,
            "z": 1.0
          }
        }
      },
      "type": "object"
    },
    "UiRect": {
      "additionalProperties": false,
      "description": "Logical coordinates for a host-rendered UI element.\n\nBoth axes run 0..100 and **y points up**: y = 0 is the bottom of the screen\nand a rect grows upward from its y. Most UI systems are y-down, so this is\nthe easiest thing for an author who cannot see the screen to get wrong.\n\nThe platform host maps this design space to its viewport. The engine does\nnot know about pixels, DPI, safe areas, fonts, or platform widgets.",
      "properties": {
        "height": {
          "format": "double",
          "type": "number"
        },
        "width": {
          "format": "double",
          "type": "number"
        },
        "x": {
          "format": "double",
          "type": "number"
