        "frost_touch",
        "shatter",
        "slow_force"
      ],
      "desc": "先用凝霜兵標記目標，碎冰兵跟進；搭配沉重把慢速換成傷害。",
      "name": "霜鋼重擊",
      "tradeoff": "同一次首次上霜不能立即吃碎冰；重步需負向速度加成。"
    },
    {
      "core": [
        "frenzy",
        "hunter_vigor",
        "pierce"
      ],
      "desc": "追著怪物潮累積5／10／15連殺，穿透兵靠擊殺延長作戰。",
      "name": "狂獵續航",
      "tradeoff": "2.5秒沒有擊殺後開始掉層；王少的時段不容易維持。"
    },
    {
      "core": [
        "last_stand",
        "ember_burst",
        "expire_burst"
      ],
      "desc": "活到最後四分之一壽命拚強力撞擊；接觸終結或到期各有爆發。",
      "name": "背水餘燼",
      "tradeoff": "接觸爆炸與到期爆炸不會在同一次死亡疊觸發；召回不爆炸。"
    },
    {
      "core": [
        "landing_spin",
        "spin_master",
        "king_hunter"
      ],
      "desc": "任何兵種都能裝落地旋轉斬，擴圈壓住怪群，再往前撞王。",
      "name": "落地風環",
      "tradeoff": "擴張不會自行授予旋轉技能；空中也會消耗壽命。"
    },
    {
      "core": [
        "flame_cloak",
        "phoenix_fire",
        "longlife"
      ],
      "desc": "貼身火環定時灼燒，鳳凰追逐附近三怪；延命增加施法次數。",
      "name": "餘火巡獵",
      "tradeoff": "火環隨士兵死亡結束；已發出的鳳凰與灼燒會繼續。"
    },
    {
      "core": [
        "plague_vial",
        "haste",
        "bounce_life"
      ],
      "desc": "每走六單位投擲毒瓶，靠速度和折返鋪出毒霧路線。",
      "name": "疾走鍊金",
      "tradeoff": "每兵最多四片毒霧；同種毒傷只刷新、不疊加，空中不計步。"
    },
    {
      "core": [
        "ember_trail",
        "slick_oil",
        "oil_legacy"
      ],
      "desc": "走過留下火路，命中抹油減速；油怪遇火爆燃，倒下再留油池接續燃燒。",
      "name": "焦土油獵",
      "tradeoff": "火路只有三秒；召回與結算不會留下死亡油池。"
    },
    {
      "core": [
        "rain_strike",
        "storm_touch",
        "pierce"
      ],
      "desc": "命中灑水，再用雷擊引發感電；沿附近潮濕怪物傳導，水池也會帶電。",
      "name": "雨幕雷網",
      "tradeoff": "每次最多傳導四怪；感電不再觸發命中技能，LOCK 只傷害指定目標。"
    },
    {
      "core": [
        "plunder",
        "firstborn",
        "momentum"
      ],
      "desc": "出生三秒衝刺配騎兵穿透，每次主要命中帶回一枚金幣；勢能把加速轉成傷害。",
      "name": "疾掠騎團",
      "tradeoff": "掠奪讓總壽命減半；持續傷害不領錢，LOCK 同一目標仍只撞一次。"
    },
    {
      "core": [
        "march_capacitor",
        "third_pulse",
        "pierce"
      ],
      "desc": "每走八單位蓄力，下一命中消耗蓄力增傷；每第三次主要命中震開周圍。",
      "name": "蓄步三連",
      "tradeoff": "蓄力最多兩層；震波最多四怪，不會繼續累加命中次數。"
    },
    {
      "core": [
        "battle_elegy",
        "grave_bloom",
        "delayed_bloom"
      ],
      "desc": "隊友倒下鼓舞附近持有者，擊殺留下焰葬；活過兩秒再放一次火心。",
      "name": "薪火送葬",
      "tradeoff": "鼓舞刷新不疊加，焰葬與其他觸發爆發不會互相無限引爆。"
    },
    {
      "core": [
        "last_echo",
        "longlife",
        "hunter_vigor"
      ],
      "desc": "延長作戰時間，剩四分之一壽命時釋放一次寒霜；擊殺再爭取存活。",
      "name": "暮霜長征",
      "tradeoff": "寒霜每兵只觸發一次，提早接觸死亡或召回不會補放。"
    },
    {
      "core": [
        "cinder_seal",
        "chain_fuse",
        "pierce"
      ],
      "desc": "穿過敵群埋下時印與導火種，倒數收束後一顆接一顆炸開。",
      "name": "紅蓮時爆",
      "tradeoff": "同玩家同種印記不疊加、不延後；一次導火鏈最多六顆。"
    },
    {
      "core": [
        "thunder_fan",
        "rain_strike",
        "starfall"
      ],
      "desc": "三次命中開屏放雷，潮濕引發感電；存活到2.8秒後再落下三枚星火。",
      "name": "雷羽星落",
      "tradeoff": "扇形有方向、落星有預告；敵人可以離開固定落點。"
    },
    {
      "core": [
        "echo_blade",
        "soul_return",
        "firstborn"
      ],
      "desc": "衝刺劃出回斬印，半秒後斷界；死亡後英魂沿最後十二單位路徑返斬。",
      "name": "斷界歸魂",
      "tradeoff": "回斬不追著敵人移動；英魂不賺掠奪金，也不再生成英魂。"
    },
    {
      "core": [
        "gravity_law",
        "contact_mine",
        "quick_chant"
      ],
      "desc": "把附近小怪聚向伏雷，再靠迅咒更快補雷；怪物潮能接成連續爆破。",
      "name": "引力雷田",
      "tradeoff": "王不受拉引；伏雷有武裝時間，同部位可用研究或附魔補齊。"
    },
    {
      "core": [
        "step_orb",
        "overload_script",
        "firstborn"
      ],
      "desc": "高速跑動鋪出光球，過載讓爆炸翻倍；1.4秒倒數後接連收網。",
      "name": "流明過載",
      "tradeoff": "過載拖慢週期技能，步雷靠距離觸發；每兵最多十六顆。"
    },
    {
      "core": [
        "comrade_oath",
        "resonant_debt",
        "phoenix_fire"
      ],
      "desc": "友軍交錯接觸互相加持，鳳凰持續傷害替債印累積五擊，再引發共鳴爆破。",
      "name": "戰誓共鳴",
      "tradeoff": "同種戰誓刷新不疊加；債印只算己方，四秒沒有集滿就消失。"
    },
    {
      "core": [
        "storm_payload",
        "step_orb",
        "rain_strike"
      ],
      "desc": "喚雨先把怪物打濕，再讓沿途光球轉雷傷引起感電，把地面接成雷網。",
      "name": "雷紋織陣",
      "tradeoff": "接枝只改伏雷、步雷與債印的爆炸；LOCK仍只影響指定怪。"
    },
    {
      "core": [
        "legacy_gift",
        "guard_bequest",
        "short_fuse"
      ],
      "desc": "短命前鋒倒下，隨機強化活著的隊友，並以遺願裂開附近敵人護甲；可混編騎兵承接增傷。",
      "name": "英魂破陣",
      "tradeoff": "沒有活隊友就無法傳承；每兵最多三層，不延命、不傳遞裝備，破防仍可能落空。"
    }
