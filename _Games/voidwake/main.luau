-- Engine-owned presentation for VOIDWAKE. This fragment is inlined into the
-- single Luau entry before publish(); it reads S and never changes gameplay or
-- consumes its random stream. Bitmap art is imagegen PNGs; native particle
-- shapes, Bloom and material resources are provided by the official player.
local visualFrame = 0
local visualSerial = 0
local visualFired = 0
local visualVisibility: {[string]: boolean} = {}
local visualHandles: {any} = {}
local visualBatchHandles: {[string]: string} = {}
local visualExhaust: {any} = {}
local visualSeenEffects: {[number]: boolean} = {}
local visualEffectStarted: {[number]: number} = {}
local visualWaves: {any} = {}
local visualEchoes: {any} = {}
local visualWaveSlot = 0
local visualEchoSlot = 0
local visualShieldAt = -100
local visualLastEcho = -100
local visualDropped = 0
local visualCounts: {[string]: number} = {}

local function visualSlot(prefix:string, index:number):string
 return prefix .. (index < 10 and "0" or "") .. tostring(index)
end

local function visualShow(api:any, entity:string, visible:boolean)
 if visualVisibility[entity] ~= visible then
  api.entity.setSpriteVisible(entity, visible)
  visualVisibility[entity] = visible
 end
end

local function visualPlace(api:any, entity:string, x:number, y:number, angle:number, scale:number)
 api.entity.setTransform2D(entity, {
  position={x=x,y=-y}, rotation=-angle, scale={x=scale,y=scale},
 })
 visualShow(api, entity, true)
end

local function visualSeed(salt:number):number
 return math.floor(((S.seed or 1) + salt * 7919 + visualSerial * 104729) % 2147483647)
end

local function visualCanReserve(api:any, count:number):boolean
 local budget = api.particle.stats()
 local available=budget.active_handles < 58 and budget.reserved_particles + count <= 3900
 if not available then visualDropped+=1 end
 return available
end

local function visualPlay(api:any, effect:string, x:number, y:number, salt:number, births:number, life:number):string?
 if not visualCanReserve(api, births) then return nil end
 visualSerial += 1
 local handle = api.particle.play(effect, {x=x,y=-y,z=0.08}, visualSeed(salt))
 table.insert(visualHandles, {handle=handle,expires=visualFrame+life})
 visualCounts[effect]=(visualCounts[effect] or 0)+1
 return handle
end

-- Bullets and pickups share a few native instanced particle batches. Updating
-- their exact positions replaces the preceding batch rather than allocating
-- one effect handle per projectile or introducing another renderer.
local function visualBatch(api:any, key:string, effect:string, positions:{any}, maxCount:number, birthsPerOrigin:number)
 local previousHandle = visualBatchHandles[key]
 if previousHandle then api.particle.stop(previousHandle); visualBatchHandles[key] = nil end
 local count = math.min(#positions, maxCount)
 if count == 0 or not visualCanReserve(api, count*birthsPerOrigin) then return end
 local packed = buffer.create(count*12)
 for index=1,count do
  local point = positions[index]
  local offset = (index-1)*12
  buffer.writef32(packed,offset,point.x)
  buffer.writef32(packed,offset+4,-point.y)
  buffer.writef32(packed,offset+8,0.09)
 end
 visualSerial += 1
 visualBatchHandles[key] = api.particle.play_batch(effect, packed, visualSeed(visualFrame))
end

-- A fixed pool bounds image/material work independently of enemy density.
-- These are original imagegen textures shaded through the engine API.
local function visualWave(event:any, tint:{number}, energy:number, lifetime:number)
 visualWaveSlot=visualWaveSlot%6+1
 visualWaves[visualWaveSlot]={x=event.x,y=event.y,radius=event.radius,
  tint=tint,energy=energy,started=visualFrame,lifetime=lifetime,
  angle=(event.id%13)*.41,blast=event.kind=="explosion"}
end

local function resetPresentation(api:any)
 for _,record in ipairs(visualHandles) do api.particle.stop(record.handle) end
 for _,handle in pairs(visualBatchHandles) do api.particle.stop(handle) end
 visualFrame=0; visualSerial=0; visualFired=0
 visualVisibility={}; visualHandles={}; visualBatchHandles={}
 visualExhaust={}; visualSeenEffects={}
 visualEffectStarted={}
 visualWaves={};visualEchoes={};visualWaveSlot=0;visualEchoSlot=0
 visualShieldAt=-100;visualLastEcho=-100;visualDropped=0;visualCounts={}
 for index=1,28 do visualShow(api,visualSlot("hostile_",index),false) end
 for index=1,19 do visualShow(api,visualSlot("rock_",index),false) end
 for index=1,16 do visualShow(api,visualSlot("detonation_",index),false) end
 for index=1,6 do visualShow(api,visualSlot("plasma_wave_",index),false) end
 for index=1,4 do visualShow(api,visualSlot("phase_echo_",index),false) end
 visualShow(api,"player_shield_ripple",false)
 visualShow(api,"boss",false)
 visualShow(api,"player",true)
 api.shader.setMaterial("player","player_hull")
 api.shader.setMaterial("nebula","nebula_grade")
end

local function updatePresentation(api:any)
 visualFrame += 1
 local p = S.player
 local retained = {}
 for _,record in ipairs(visualHandles) do
  if record.expires >= visualFrame then table.insert(retained,record) end
 end
 visualHandles=retained

 -- The menu uses the same imagegen hull and engine material at showcase
 -- scale. Only its visual transform changes; the ship's gameplay state is
 -- still the untouched origin used when a sortie starts.
 local showcase = S.phase=="menu"
 local layoutValues=resolveVoidwakeUi(api).values
 local shipX = p.x + (showcase and layoutValues.showcaseX or 0)
 local shipY = p.y + (showcase and (layoutValues.showcaseY+math.sin(visualFrame/75)*5) or 0)
 local shipAngle = showcase and 0.12 or p.angle
 local shipScale = showcase and layoutValues.showcaseScale or 1

 -- The large imagegen nebula moves more slowly than the ship. Its material
 -- gently grades the original photographic detail through the Shader API.
 api.entity.setTransform2D("nebula",{
  position={x=p.x*0.93-300,y=-p.y*0.93},rotation=0,scale={x=1,y=1},
 })
 local sectorTint = S.sector==4 and {1.0,0.48,0.26}
  or S.sector==3 and {0.68,0.66,1.0}
  or S.sector==2 and {0.5,0.95,1.0} or {1.0,0.9,0.75}
 api.shader.setUniform("nebula_grade","sectorTint",sectorTint)
 api.shader.setUniform("nebula_grade","exposure",showcase and 0.76 or 0.96)

 if p.hp > 0 then visualPlace(api,"player",shipX,shipY,shipAngle,shipScale)
 else visualShow(api,"player",false) end
 api.shader.setUniform("player_hull","strength",showcase and .28 or p.shield/math.max(1,p.maxShield)+(p.dashTime>0 and 1.2 or 0))
 api.shader.setUniform("player_hull","impact",math.min(1,p.hit*4))

 for index=1,19 do
  local rock=S.asteroids[index]
  local entity=visualSlot("rock_",index)
  if rock and (not showcase or ((rock.x-shipX)^2+(rock.y-shipY)^2)>280^2) then visualPlace(api,entity,rock.x,rock.y,rock.angle,rock.radius*2/100)
  else visualShow(api,entity,false) end
 end

 local hostileIndex=0
 local hasBoss=false
 for _,enemy in ipairs(S.enemies) do
  if enemy.kind=="boss" then
   hasBoss=true
   visualPlace(api,"boss",enemy.x,enemy.y,enemy.angle,1)
   api.shader.setUniform("boss_hull","impact",math.min(1,enemy.hit*5))
   api.shader.setUniform("boss_hull","strength",0.3+enemy.telegraph*1.7)
  else
   hostileIndex+=1
   if hostileIndex<=28 then
    local entity=visualSlot("hostile_",hostileIndex)
    local material=visualSlot("enemy_hull_",hostileIndex)
    visualPlace(api,entity,enemy.x,enemy.y,enemy.angle,enemy.kind=="heavy" and 1.38 or enemy.kind=="shooter" and 0.94 or 1)
    api.shader.setUniform(material,"impact",math.min(1,enemy.hit*6))
    api.shader.setUniform(material,"strength",enemy.kind=="shooter" and 0.35 or 0.12)
   end
  end
 end
 for index=hostileIndex+1,28 do visualShow(api,visualSlot("hostile_",index),false) end
 visualShow(api,"boss",hasBoss)

 local friendly,hostile,xp,repair,friendlyTrail,hostileTrail={},{},{},{},{},{}
 for _,projectile in ipairs(S.bullets) do
  table.insert(projectile.friendly and friendly or hostile,{x=projectile.x,y=projectile.y})
  local trail=projectile.friendly and friendlyTrail or hostileTrail
  -- These positions come from the real swept ballistic segment. No separate
  -- projectile simulation or renderer is introduced for the tracer.
  local previousX=projectile.previousX or projectile.x
  local previousY=projectile.previousY or projectile.y
  table.insert(trail,{x=previousX,y=previousY})
  table.insert(trail,{x=(previousX+projectile.x)*.5,y=(previousY+projectile.y)*.5})
 end
 for _,pickup in ipairs(S.pickups) do
  table.insert(pickup.kind=="repair" and repair or xp,{x=pickup.x,y=pickup.y})
 end
 visualBatch(api,"friendly","rail_bolts",friendly,280,2)
 visualBatch(api,"hostile","hostile_bolts",hostile,280,2)
 visualBatch(api,"xp","salvage_xp",xp,192,2)
 visualBatch(api,"repair","salvage_repair",repair,96,2)
 visualBatch(api,"friendly_trail","rail_tracers",friendlyTrail,160,1)
 visualBatch(api,"hostile_trail","hostile_tracers",hostileTrail,80,1)

 -- Sixteen declarative exhaust directions let the engine orient the plume.
 -- Moving only the emission origin leaves already-born ions in world space.
 local emitting = p.hp>0 and (S.phase=="playing" or S.phase=="menu")
 local direction = math.floor((shipAngle/(math.pi*2)*16)+0.5)%16
 local boosting=p.dashTime>0 and S.phase=="playing"
 local plumeMode=showcase and "showcase_exhaust_" or boosting and "afterburner_" or "ion_exhaust_"
 for nozzle=1,2 do
  local record=visualExhaust[nozzle]
  local side=(nozzle==1 and -8 or 8)*shipScale
  local tail=27*shipScale
  local x=shipX-math.sin(shipAngle)*tail+math.cos(shipAngle)*side
  local y=shipY+math.cos(shipAngle)*tail+math.sin(shipAngle)*side
  if record and (not emitting or record.direction~=direction or record.mode~=plumeMode or visualFrame>=record.refresh) then
   api.particle.finish(record.handle)
   visualExhaust[nozzle]=nil
   record=nil
  end
  if emitting and not record then
   local handle=visualPlay(api,plumeMode..tostring(direction),x,y,nozzle,boosting and 52 or 26,48)
   if handle then
    record={handle=handle,direction=direction,mode=plumeMode,refresh=visualFrame+20}
    visualExhaust[nozzle]=record
   end
  end
  if record then api.particle.move(record.handle,{x=x,y=-y,z=0.045}) end
 end

 if S.fired>visualFired then
  visualPlay(api,"muzzle_flash",p.x+math.sin(p.angle)*33,p.y-math.cos(p.angle)*33,S.fired,7,12)
 end
 visualFired=S.fired

 -- The dash leaves four short hull echoes. They are plain scene sprites with
 -- imagegen ship art and a shared Shader API interface, behind the live ship.
 if boosting and visualFrame-visualLastEcho>=3 then
  visualEchoSlot=visualEchoSlot%4+1
  visualEchoes[visualEchoSlot]={x=p.x,y=p.y,angle=p.angle,started=visualFrame}
  visualLastEcho=visualFrame
 end

 -- The PNG supplies detailed blast debris; authored native emitters add the
 -- pressure wave, fast sparks and delayed embers. FX IDs prevent repeats on
 -- pause, upgrade screens, or several publications of the same game state.
 local seen:{[number]:boolean}={}
 local effectStarts:{[number]:number}={}
 local detonationIndex=0
 for _,event in ipairs(S.effects) do
  seen[event.id]=true
  effectStarts[event.id]=visualEffectStarted[event.id] or visualFrame
  if not visualSeenEffects[event.id] then
   if event.kind=="explosion" then
    visualPlay(api,event.radius>140 and "capital_detonation" or "hull_detonation",event.x,event.y,event.id,40,72)
    visualWave(event,{1,.55,.22},.68,21)
   elseif event.kind=="hit" then
    visualPlay(api,"impact_sparks",event.x,event.y,event.id,9,20)
    if event.radius>=50 then
     visualShieldAt=visualFrame
     visualPlay(api,"shield_impact",event.x,event.y,event.id,13,20)
    end
   elseif event.kind=="burst" then
    visualPlay(api,"emp_discharge",event.x,event.y,event.id,24,55)
    visualWave(event,{.3,.78,1},.8,28)
   elseif event.kind=="pulse" then
    visualPlay(api,event.radius>150 and "emp_discharge" or "phase_dash",event.x,event.y,event.id,event.radius>150 and 24 or 13,55)
    visualWave(event,{.32,.76,1},event.radius>150 and .6 or .24,event.radius>150 and 28 or 16)
   end
  end
  -- The bitmap supplies a brief dense gas accent, not a long static blast.
  -- Its material advects/swivels UV detail while independent native debris,
  -- cooling embers and smoke continue their own velocities and lifetimes.
  local blastAge=(visualFrame-effectStarts[event.id])/12
  if event.kind=="explosion" and blastAge<1 then
   detonationIndex+=1
   if detonationIndex<=16 then
    local entity=visualSlot("detonation_",detonationIndex)
    local age=blastAge
    local scale=event.radius*2/128*(0.52+(1-(1-age)^2)*.8)
    visualPlace(api,entity,event.x,event.y,(event.id%13)*0.41,scale)
    api.shader.setUniform(entity,"opacity",math.max(0,(1-age)^1.45))
    api.shader.setUniform(entity,"heat",math.max(0,1-age*1.6))
    api.shader.setUniform(entity,"age",age)
   end
  end
 end
 for index=detonationIndex+1,16 do visualShow(api,visualSlot("detonation_",index),false) end
 visualSeenEffects=seen
 visualEffectStarted=effectStarts

 local activeWaves,activeEchoes=0,0
 for index=1,6 do
  local wave=visualWaves[index]
  local entity=visualSlot("plasma_wave_",index)
  local age=wave and (visualFrame-wave.started)/wave.lifetime or 1
  if wave and age<1 then
   activeWaves+=1
   local expand=1-(1-age)^3
   local radius=wave.radius*(wave.blast and (.35+expand*1.2) or (.12+expand*.88))
   visualPlace(api,entity,wave.x,wave.y,wave.angle,radius*2/128)
   api.shader.setUniform(entity,"opacity",math.min(1,age*14+.25)*(1-age)^1.6)
   api.shader.setUniform(entity,"energy",wave.energy*(1-age))
   api.shader.setUniform(entity,"age",age)
   api.shader.setUniform(entity,"tint",wave.tint)
  else visualShow(api,entity,false) end
 end
 for index=1,4 do
  local echo=visualEchoes[index]
  local entity=visualSlot("phase_echo_",index)
  local age=echo and (visualFrame-echo.started)/14 or 1
  if echo and age<1 then
   activeEchoes+=1
   visualPlace(api,entity,echo.x,echo.y,echo.angle,1+age*.09)
   api.shader.setUniform(entity,"opacity",(1-age)^2*.24)
  else visualShow(api,entity,false) end
 end
 local shieldPulse=math.max(0,1-(visualFrame-visualShieldAt)/22)^2
 if shieldPulse>0 and p.hp>0 then
  visualPlace(api,"player_shield_ripple",p.x,p.y,0,1+(1-math.sqrt(shieldPulse))*.18)
  api.shader.setUniform("player_shield_ripple","pulse",shieldPulse)
  api.shader.setUniform("player_shield_ripple","tint",p.shield>0 and {.3,.75,1} or {1,.52,.22})
  api.shader.setUniform("player_shield_ripple","impactDirection",{math.sin(p.angle),math.cos(p.angle)})
 else visualShow(api,"player_shield_ripple",false) end

 local budget=api.particle.stats()
 api.observation.set("presentation",{
  renderer="official",particle_backend="native_declarative",shader_materials=59,
  plume_mode=plumeMode,afterburner=boosting,
  active_waves=activeWaves,active_echoes=activeEchoes,shield_pulse=shieldPulse,
  trail_points=math.min(#friendlyTrail,160)+math.min(#hostileTrail,80),
  active_handles=budget.active_handles,reserved_particles=budget.reserved_particles,
  live_particles=budget.live_particles,dropped_effects=visualDropped,
  explosions_played=(visualCounts.hull_detonation or 0)+(visualCounts.capital_detonation or 0),
  muzzle_flashes=visualCounts.muzzle_flash or 0,
  shield_impacts=visualCounts.shield_impact or 0,
  ability_discharges=visualCounts.emp_discharge or 0,
 })
end

local function fresh(api:EngineApi,phase:string)
 nextId=0
 S={phase=phase,time=0,sectorTime=0,sectorDuration=SECTOR_DURATION,sector=1,wave=0,kills=0,
  xp=0,xpNext=14,level=1,credits=0,seed=0,choices={},upgrades={},upgradesInstalled=0,
  autoFire=true,burstCooldown=0,dashCooldown=0,bossSpawned=false,sectorDraft=false,
  levelDraft=false,fireCooldown=0,spawnCooldown=2.2,waveCooldown=8,lastDamage=-10,
  fired=0,damageTaken=0,burstCount=0,dashCount=0,previousPhase="playing",
  player={x=0,y=0,vx=0,vy=0,angle=0,radius=18,hp=100,maxHp=100,shield=60,maxShield=60,
   boost=100,boostMax=100,invuln=0,dashTime=0,dashX=0,dashY=-1,hit=0},
  stats={damage=18,fireInterval=.19,projectiles=1,speed=220,pierce=0,magnet=100,
   shieldRegen=9,dashCooldown=2.4,burstDamage=85,burstRadius=330,burstInterval=12},
  enemies={},bullets={},pickups={},effects={},asteroids={},bounds=BOUNDS}
 -- The runtime seed itself is host-owned. This reproducible signature identifies
 -- the content generated from it without introducing a second random generator.
 S.seed=api.random.nextInt(1,2147483646)
 for i=1,19 do
  local x=(api.random.nextFloat()*2-1)*1270
  local y=(api.random.nextFloat()*2-1)*870
  if x*x+y*y<220*220 then x+=440 end
  table.insert(S.asteroids,{id=id(),x=x,y=y,radius=25+api.random.nextFloat()*35,
   angle=api.random.nextFloat()*math.pi*2,spin=(api.random.nextFloat()-.5)*.08})
 end
 abandonPrompt=false
 resetPresentation(api)
 resetAudio(api)
end
-- A published ViewModel is a stable interchange format. Native and WASM may
-- differ at the last bit of an intermediate float; leave simulation untouched
-- and publish sub-microunit precision consistently across those targets.
local function viewValue(value:any):any
 if type(value)=="number" then
  if value==math.floor(value) then return value end
  return math.floor(value*1000000+.5)/1000000
 elseif type(value)=="table" then
  local result:any={}
  for key,child in pairs(value) do result[key]=viewValue(child) end
  return result
 end
 return value
end
local function publish(api:EngineApi)
 api.entity.setPosition("player",{x=S.player.x,y=-S.player.y})
 api.camera.setPosition({x=S.player.x,y=-S.player.y})
 updatePresentation(api)
 updateAudio(api)
 updateUi(api)
 api.observation.set("game",viewValue(S))
 -- Small semantic observations make headless replay assertions independent
 -- from the renderer and from a complete, brittle state-object comparison.
 api.observation.set("phase",S.phase)
 api.observation.set("fired",S.fired)
 api.observation.set("sector",S.sector)
 api.observation.set("level",S.level)
 api.observation.set("kills",S.kills)
 api.observation.set("time",viewValue(S.time))
 api.observation.set("player_x",viewValue(S.player.x))
 api.observation.set("player_y",viewValue(S.player.y))
 api.observation.set("autoFire",S.autoFire)
 api.observation.set("burstCount",S.burstCount)
 api.observation.set("dashCount",S.dashCount)
 api.observation.set("upgradesInstalled",S.upgradesInstalled)
 api.observation.set("choiceCount",#S.choices)
 api.observation.set("movedRight",S.player.x>100)
 api.observation.set("finiteState",S.player.hp>=0 and S.player.hp<=S.player.maxHp and S.player.shield>=0 and S.player.shield<=S.player.maxShield)
end
local function bullet(owner:string,x:number,y:number,angle:number,speed:number,damage:number,radius:number,pierce:number)
 if #S.bullets>=280 then return end
 table.insert(S.bullets,{id=id(),owner=owner,friendly=owner=="player",x=x,y=y,
  previousX=x,previousY=y,angle=angle,vx=math.sin(angle)*speed,vy=-math.cos(angle)*speed,
  damage=damage,radius=radius,life=owner=="player" and 1.5 or 4,pierce=pierce,hits={}})
end
local function spawnEnemy(api:EngineApi,kind:string?)
 if #S.enemies>=28 then return end
 local k=kind or (api.random.nextFloat()<.24 and "shooter" or "chaser")
 if not kind and S.sector>=2 and api.random.nextFloat()<.19 then k="heavy" end
 local a=api.random.nextFloat()*math.pi*2
 local p=S.player
 local d=480+api.random.nextFloat()*180
 local x=clamp(p.x+math.cos(a)*d,-1350,1350)
 local y=clamp(p.y+math.sin(a)*d,-950,950)
 local hp=(k=="boss" and 2200 or k=="heavy" and 115 or k=="shooter" and 46 or 32)+(S.sector-1)*(k=="boss" and 0 or 12)
 table.insert(S.enemies,{id=id(),kind=k,boss=k=="boss",x=x,y=y,angle=angleTo(x,y,p.x,p.y),
  radius=k=="boss" and 82 or k=="heavy" and 32 or 22,hp=hp,maxHp=hp,
  speed=k=="boss" and 45 or k=="heavy" and 64 or k=="shooter" and 92 or 108+S.sector*8,
  cooldown=k=="boss" and 2 or .9+api.random.nextFloat()*2,telegraph=0,pattern=0,hit=0,age=0})
end
local function draft(api:EngineApi,sectorClear:boolean)
 S.phase="upgrade"
 S.sectorDraft=sectorClear
 S.choices={}
 local used:{[number]:boolean}={}
 for _=1,3 do
  local n=api.random.nextInt(1,#UPGRADES)
  while used[n] do n=n%#UPGRADES+1 end
  used[n]=true
  local u=UPGRADES[n]
  table.insert(S.choices,{id=u.id,name=u.name,description=u.description,desc=u.description,rarity=u.rarity})
 end
end
local function install(index:number)
 local chosen=S.choices[index]
 if not chosen then return end
 local k=chosen.id
 local p,st=S.player,S.stats
 if k=="reactor" then st.damage*=1.25
 elseif k=="autoloader" then st.fireInterval=math.max(.055,st.fireInterval*.82)
 elseif k=="twin" then st.projectiles=math.min(5,st.projectiles+1);if st.projectiles==5 then st.damage*=1.1 end
 elseif k=="shield" then p.maxShield+=30;p.shield=p.maxShield;st.shieldRegen*=1.2
 elseif k=="hull" then p.maxHp+=35;p.hp=math.min(p.maxHp,p.hp+50)
 elseif k=="thruster" then st.speed*=1.15;st.dashCooldown*=.85
 elseif k=="magnet" then st.magnet+=85;p.hp=math.min(p.maxHp,p.hp+25)
 elseif k=="pulse" then st.burstDamage*=1.6;st.burstRadius*=1.2;st.burstInterval*=.85
 elseif k=="pierce" then st.pierce+=1;st.damage*=1.1 end
 S.upgrades[k]=(S.upgrades[k] or 0)+1
 S.upgradesInstalled+=1
 S.choices={}
 if S.sectorDraft then
  S.sector+=1;S.sectorTime=0;S.enemies={};S.bullets={};S.wave=0;S.spawnCooldown=2
  p.shield=p.maxShield;p.hp=math.min(p.maxHp,p.hp+15);S.burstCooldown=0
  fx("pulse",p.x,p.y,430,1)
 end
 S.sectorDraft=false
 S.phase="playing"
end
local function damagePlayer(amount:number)
 local p=S.player
 if p.invuln>0 or S.phase~="playing" then return end
 local blocked=math.min(p.shield,amount)
 p.shield-=blocked
 p.hp=math.max(0,p.hp-(amount-blocked))
 p.invuln=.55;p.hit=.3;S.lastDamage=S.time;S.damageTaken+=amount
 fx("hit",p.x,p.y,55,.3)
 if p.hp<=0 then S.phase="gameover";fx("explosion",p.x,p.y,130,1.5) end
end
local function destroyEnemy(api:EngineApi,index:number)
 local e=S.enemies[index]
 fx("explosion",e.x,e.y,e.kind=="boss" and 200 or e.radius*1.7,e.kind=="boss" and 1.5 or .65)
 S.kills+=1
 S.credits+=e.kind=="boss" and 200 or e.kind=="heavy" and 12 or 5
 if e.kind=="boss" then S.phase="victory";S.bullets={};table.remove(S.enemies,index);return end
 table.insert(S.pickups,{id=id(),kind="xp",x=e.x,y=e.y,value=e.kind=="heavy" and 7 or 3,radius=10,life=25})
 if api.random.nextFloat()<.13 then table.insert(S.pickups,{id=id(),kind="repair",x=e.x+16,y=e.y,value=18,radius=12,life=25}) end
 table.remove(S.enemies,index)
end
local function nearestEnemy():any
 local result=nil
 -- Automatic targeting waits until a hostile reaches the combat viewport.
 -- Manual aim still uses the projectile's full ballistic range.
 local best=500^2
 for _,e in ipairs(S.enemies) do
  local d=dist2(S.player.x,S.player.y,e.x,e.y)
  if d<best then best=d;result=e end
 end
 return result
end
-- Swept circle impact: fast projectiles cannot tunnel between fixed ticks.
local function segmentDistance2(ax:number,ay:number,bx:number,by:number,px:number,py:number):number
 local dx,dy=bx-ax,by-ay
 local den=dx*dx+dy*dy
 local t=den>0 and clamp(((px-ax)*dx+(py-ay)*dy)/den,0,1) or 0
 return dist2(ax+dx*t,ay+dy*t,px,py)
end
local function updatePlayer(api:EngineApi,dt:number,dashPressed:boolean,burstPressed:boolean)
 local p,st=S.player,S.stats
 local function down(a:string,b:string):boolean return api.input.isDown(a) or api.input.isDown(b) end
 local dx=(down("KeyD","ArrowRight") and 1 or 0)-(down("KeyA","ArrowLeft") and 1 or 0)
 local dy=(down("KeyS","ArrowDown") and 1 or 0)-(down("KeyW","ArrowUp") and 1 or 0)
 local length=math.sqrt(dx*dx+dy*dy)
 if length>0 then dx/=length;dy/=length end
 S.dashCooldown=math.max(0,S.dashCooldown-dt)
 S.burstCooldown=math.max(0,S.burstCooldown-dt)
 p.invuln=math.max(0,p.invuln-dt);p.hit=math.max(0,p.hit-dt)
 p.boost=math.min(p.boostMax,p.boost+dt*29)
 if dashPressed and S.dashCooldown<=0 and p.boost>=35 then
  p.dashX=length>0 and dx or math.sin(p.angle)
  p.dashY=length>0 and dy or -math.cos(p.angle)
  p.dashTime=.19;p.invuln=.3;p.boost-=35;S.dashCooldown=st.dashCooldown;S.dashCount+=1
  fx("pulse",p.x,p.y,60,.32)
 end
 if p.dashTime>0 then p.dashTime=math.max(0,p.dashTime-dt);p.vx=p.dashX*st.speed*3.6;p.vy=p.dashY*st.speed*3.6
 else p.vx=dx*st.speed;p.vy=dy*st.speed end
 p.x=clamp(p.x+p.vx*dt,-BOUNDS.x+p.radius,BOUNDS.x-p.radius)
 p.y=clamp(p.y+p.vy*dt,-BOUNDS.y+p.radius,BOUNDS.y-p.radius)
 -- Rocks are solid obstacles. Contact separates the ship without arbitrary
 -- collision damage; hostile contact and projectiles remain damaging.
 for _,rock in ipairs(S.asteroids) do
  local rx,ry=p.x-rock.x,p.y-rock.y
  local d=math.sqrt(rx*rx+ry*ry)
  local r=p.radius+rock.radius
  if d<r and d>.001 then p.x=rock.x+rx/d*r;p.y=rock.y+ry/d*r end
 end
 if S.time-S.lastDamage>3 then p.shield=math.min(p.maxShield,p.shield+st.shieldRegen*dt) end
 local pointer=api.input.getPointerPosition()
 pointer={x=pointer.x,y=-pointer.y}
 local target=nearestEnemy()
 if S.autoFire and not api.input.isPointerDown() and target then
  -- A small lead makes moving targets readable while keeping ballistic shots.
  p.angle=angleTo(p.x,p.y,target.x,target.y)
 elseif dist2(p.x,p.y,pointer.x,pointer.y)>16 then p.angle=angleTo(p.x,p.y,pointer.x,pointer.y) end
 S.fireCooldown=math.max(0,S.fireCooldown-dt)
 if (api.input.isPointerDown() or api.input.isDown("Fire") or (S.autoFire and target)) and S.fireCooldown<=0 then
  S.fireCooldown=st.fireInterval
  for n=1,st.projectiles do
   local offset=(n-(st.projectiles+1)/2)*12
   bullet("player",p.x+math.sin(p.angle)*31+math.cos(p.angle)*offset,p.y-math.cos(p.angle)*31+math.sin(p.angle)*offset,p.angle,750,st.damage,5,st.pierce)
  end
  S.fired+=1
 end
 if burstPressed and S.burstCooldown<=0 then
  S.burstCooldown=st.burstInterval;S.burstCount+=1
  fx("burst",p.x,p.y,st.burstRadius,.85)
  for _,e in ipairs(S.enemies) do if dist2(p.x,p.y,e.x,e.y)<(st.burstRadius+e.radius)^2 then e.hp-=st.burstDamage;e.hit=.2 end end
  for i=#S.bullets,1,-1 do local b=S.bullets[i];if not b.friendly and dist2(p.x,p.y,b.x,b.y)<st.burstRadius^2 then table.remove(S.bullets,i) end end
 end
end
local function updateEnemies(api:EngineApi,dt:number)
 local p=S.player
 for _,e in ipairs(S.enemies) do
  if e.hp<=0 then continue end
  local dx,dy=p.x-e.x,p.y-e.y
  local distance=math.max(1,math.sqrt(dx*dx+dy*dy))
  e.angle=angleTo(e.x,e.y,p.x,p.y);e.age+=dt;e.hit=math.max(0,e.hit-dt)
  local desired=e.kind=="boss" and 390 or e.kind=="shooter" and 320 or 0
  if distance>desired then e.x+=dx/distance*e.speed*dt;e.y+=dy/distance*e.speed*dt
  elseif desired>0 and distance<desired-70 then e.x-=dx/distance*e.speed*dt*.6;e.y-=dy/distance*e.speed*dt*.6 end
  if e.kind=="shooter" then
   e.cooldown-=dt
   if e.cooldown<=0 then e.cooldown=math.max(1.25,2.8-S.sector*.25);bullet("enemy",e.x,e.y,e.angle,230,12,7,0) end
  elseif e.kind=="boss" then
   e.cooldown-=dt
   e.telegraph=e.cooldown<.8 and math.max(.01,.8-e.cooldown) or 0
   if e.cooldown<=0 then
    e.pattern+=1;e.cooldown=e.hp<e.maxHp*.5 and 1.9 or 2.7;e.telegraph=0
    if e.pattern%3==0 then
     for n=0,15 do bullet("enemy",e.x,e.y,n*math.pi/8+e.age*.2,180,16,9,0) end
    else for n=-3,3 do bullet("enemy",e.x,e.y,e.angle+n*.14,255,18,9,0) end end
    if e.pattern%4==0 then spawnEnemy(api,"chaser") end
   end
  end
  if distance<e.radius+p.radius then damagePlayer(e.kind=="boss" and 30 or e.kind=="heavy" and 24 or 16)
   e.x-=dx/distance*50;e.y-=dy/distance*50 end
 end
end
local function updateBullets(api:EngineApi,dt:number)
 for i=#S.bullets,1,-1 do
  local b=S.bullets[i]
  b.previousX=b.x;b.previousY=b.y;b.x+=b.vx*dt;b.y+=b.vy*dt;b.life-=dt
  local remove=b.life<=0
  if b.friendly then
   for _,e in ipairs(S.enemies) do
    if not b.hits[tostring(e.id)] and segmentDistance2(b.previousX,b.previousY,b.x,b.y,e.x,e.y)<(e.radius+b.radius)^2 then
     e.hp-=b.damage;e.hit=.16;b.hits[tostring(e.id)]=true;fx("hit",b.x,b.y,24,.15)
     if b.pierce<=0 then remove=true;break else b.pierce-=1 end
    end
   end
  else local p=S.player
   if segmentDistance2(b.previousX,b.previousY,b.x,b.y,p.x,p.y)<(p.radius+b.radius)^2 then damagePlayer(b.damage);remove=true end
  end
  -- Friendly and hostile projectiles share the same geometric asteroid cover.
  if not remove then for _,rock in ipairs(S.asteroids) do
   if segmentDistance2(b.previousX,b.previousY,b.x,b.y,rock.x,rock.y)<(rock.radius+b.radius)^2 then remove=true;fx("hit",b.x,b.y,18,.12);break end
  end end
  if remove then table.remove(S.bullets,i) end
 end
 for i=#S.enemies,1,-1 do if S.enemies[i].hp<=0 then destroyEnemy(api,i) end end
end
local function updatePickups(dt:number)
 local p=S.player
 for i=#S.pickups,1,-1 do
  local v=S.pickups[i]
  local dx,dy=p.x-v.x,p.y-v.y
  local d=math.sqrt(dx*dx+dy*dy)
  v.life-=dt
  if d<S.stats.magnet and d>1 then local travel=math.min(d,dt*(190+550*(1-d/S.stats.magnet)));v.x+=dx/d*travel;v.y+=dy/d*travel end
  if d<27 then
   if v.kind=="repair" then p.hp=math.min(p.maxHp,p.hp+v.value);fx("pulse",p.x,p.y,60,.4)
   else S.xp+=v.value;S.credits+=1 end
   table.remove(S.pickups,i)
  elseif v.life<=0 then table.remove(S.pickups,i) end
 end
end

function Game.start(api:EngineApi)
 fresh(api,"menu")
 publish(api)
end
function Game.update(api:EngineApi,dt:number)
 -- Engine edges are non-consuming and shared by all readers in this tick.
 -- Holding an action across a phase change must not buy another upgrade.
 local pressed:{[string]:boolean}={}
 for _,name in ipairs({"Start","Restart","Menu","Pause","Resume","AutoFire","Burst","KeyQ","Dash","Space","ShiftLeft","ShiftRight","Select1","Select2","Select3","Enter","Escape","KeyF","Digit1","Digit2","Digit3","Sound","Abandon","CancelAbandon"}) do pressed[name]=api.input.wasPressed(name) end
 local start=pressed.Start or pressed.Enter
 local restart=pressed.Restart or (pressed.Enter and (S.phase=="gameover" or S.phase=="victory"))
 local menu=pressed.Menu
 local pause=pressed.Pause or pressed.Escape
 local resume=pressed.Resume
 local auto=pressed.AutoFire or pressed.KeyF
 local burst=pressed.Burst or pressed.KeyQ
 local dash,space,shift,rightShift=pressed.Dash,pressed.Space,pressed.ShiftLeft,pressed.ShiftRight
 local select1,select2,select3=pressed.Select1 or pressed.Digit1,pressed.Select2 or pressed.Digit2,pressed.Select3 or pressed.Digit3
 if pressed.Sound then soundEnabled=not soundEnabled;api.audio.setMasterVolume(soundEnabled and .45 or 0) end
 if pressed.Abandon and S.phase=="paused" then abandonPrompt=true end
 if pressed.CancelAbandon then abandonPrompt=false end
 if menu then fresh(api,"menu");publish(api);return end
 if restart or (start and S.phase=="menu") then
  fresh(api,"playing");spawnEnemy(api,"chaser");spawnEnemy(api,"shooter");spawnEnemy(api,"chaser")
  publish(api);return
 end
 if pause and S.phase=="playing" then S.phase="paused";abandonPrompt=false
 elseif (resume or pause) and S.phase=="paused" then S.phase="playing";abandonPrompt=false end
 if auto and S.phase=="playing" then S.autoFire=not S.autoFire end
 if S.phase=="upgrade" then
  if select1 then install(1) elseif select2 then install(2) elseif select3 then install(3) end
  publish(api);return
 end
 if S.phase~="playing" then publish(api);return end
 dt=math.min(dt,.05)
 S.time+=dt;S.sectorTime+=dt
 updatePlayer(api,dt,dash or space or shift or rightShift,burst)
 updateEnemies(api,dt)
 updateBullets(api,dt)
 if S.phase=="playing" then updatePickups(dt) end
 for i=1,#S.asteroids do local a:any=S.asteroids[i];a.angle+=a.spin*dt end
 for i=#S.effects,1,-1 do local e=S.effects[i];e.life-=dt;if e.life<=0 then table.remove(S.effects,i) end end
 if S.phase=="playing" then
  S.spawnCooldown-=dt;S.waveCooldown-=dt
  if S.waveCooldown<=0 then S.wave+=1;S.waveCooldown=8;for _=1,math.min(4,S.sector+1) do spawnEnemy(api) end end
  if S.spawnCooldown<=0 then S.spawnCooldown=math.max(1.3,3-S.sector*.3);spawnEnemy(api) end
  if S.sector==4 and S.sectorTime>=8 and not S.bossSpawned then S.bossSpawned=true;spawnEnemy(api,"boss") end
  if S.sector<4 and S.sectorTime>=SECTOR_DURATION then draft(api,true)
  elseif S.xp>=S.xpNext then S.xp-=S.xpNext;S.xpNext+=10;S.level+=1;draft(api,false) end
 end
 publish(api)
end
return Game
