-- This only converts an explicitly authored top-left stage rectangle to the
-- public y-up stage contract. It performs no arrangement, reflow or sizing.
local function stageRect(left: number, top: number, width: number, height: number): UiRect
    return {x=left,y=100-top-height,width=width,height=height}
end

local function selectedLabel(): string
    for _, row in ipairs(rows) do
        if row.key == selectedKey then return row.label end
    end
    return "No preset selected"
end

local function publish(api: EngineApi)
    local aspect = api.ui.getViewport().aspect
    local model = responsiveLayout
    assert(model, "Responsive layout must be created in Game.start")
    local resolved = model.resolve(api.ui.getViewport())
    local values = resolved.values
    local g: Geometry = {
        name=resolved.variant, compact=values.compact,
        audio=resolved.rect("audio"),quality=resolved.rect("quality"),
        library=resolved.rect("library"),probe=resolved.rect("probe"),
        apply=resolved.rect("apply"),reset=resolved.rect("reset"),
        slider=values.slider,sliderTrack=values.sliderTrack,combo=values.combo,
        probeButton=values.probeButton,list=values.list,
    }
    local compact = g.compact
    local ui: UiComponentKit = api.ui.components.create({
        text=textBase, button=buttonBase, slider=buttonBase,
        combobox=buttonBase, panel=panelBase,
    })
    local level = volumeControl
    assert(level, "Volume control must be created in Game.start")
    local function label(id: string, text: string, r: UiRect, style: UiStyle?): UiTextNode
        return ui.text({id=id,text=text,rect=r,style=style})
    end
    local function smallLabel(id: string, text: string, left: number, top: number, width: number): UiTextNode
        return label(id,text,stageRect(left,top,width,2.6),
            {font_size=compact and 1.45 or 1.35,font_weight=700,
             letter_spacing=0.17,color=palette.mint})
    end
    local function card(id: string, name: string, r: UiRect, children: {UiNode}): UiComponentNode
        return ui.component({id=id,component=name,rect=r,
            surface={kind="panel"},children=children})
    end

    local root: {UiNode} = {
        ui.panel({id="settings/background",rect=stageRect(0,0,100,100),
            background_for={screen=true},style={background={0.025,0.046,0.058,1},
                border_width=0,border_radius=0}}),
    }
    local margin = compact and 5 or (g.name == "medium" and 5 or 6)
    table.insert(root,label("settings/eyebrow","HARBOR  /  PREFERENCES",
        stageRect(margin,compact and 3.5 or 5,90,2.5),
        {font_size=compact and 1.45 or 1.35,font_weight=700,letter_spacing=0.25,
            color=palette.mint}))
    table.insert(root,label("settings/title","Make it yours.",
        stageRect(margin,compact and 7.2 or 9.1,90,compact and 5.5 or 7),
        {font_size=compact and 3.8 or 5.2,font_weight=700,letter_spacing=-0.08}))
    table.insert(root,label("settings/subtitle",compact and "工作空間設定 · A little more you."
        or "工作空間設定  /  A calmer space, tuned to the way you work.",
        stageRect(margin,compact and 14 or 18,90,3),
        {font_size=compact and 1.55 or 1.8,color=palette.muted}))

    local ax = g.audio.x + (compact and 3 or 2)
    local aw = g.audio.width - (compact and 6 or 4)
    local audioTop = compact and 19 or 25
    local audioChildren: {UiNode} = {
        smallLabel("audio/heading","01  AUDIO / 聲音",ax,audioTop+(compact and 1.1 or 2),aw),
        label("audio/label","Master level",stageRect(ax,compact and 24 or 31.5,aw*0.68,3.2),
            {font_size=compact and 1.85 or 2.2,font_weight=600}),
        label("audio/value",tostring(volume).."%",
            stageRect(ax+aw*0.7,compact and 24 or 31.5,aw*0.3,3.2),
            {font_size=compact and 2.1 or 2.7,font_weight=700,text_align="end",color=palette.mint}),
        level.view({text="Drag to adjust / 拖曳調整",action="AdjustLevel",
            rect=g.slider,trackRect=g.sliderTrack,style={font_size=compact and 1.55 or 1.7,
                text_align="start",color=palette.muted}}),
    }
    -- The visible track and its drag mapping share one authored rectangle.
    local track = g.sliderTrack
    local fillWidth = track.width * volume / 100
    if fillWidth > 0 then
        table.insert(audioChildren,ui.panel({id="audio/fill",rect={x=track.x,y=track.y,width=fillWidth,height=track.height},
            style={background=palette.mint,border_width=0,border_radius=0.1}}))
    end
    if volume < 100 then
        table.insert(audioChildren,ui.panel({id="audio/remainder",rect={x=track.x+fillWidth,y=track.y,width=track.width-fillWidth,height=track.height},
            style={background=palette.border,border_width=0,border_radius=0.1}}))
    end
    table.insert(root,card("audio","harbor.audio_settings",g.audio,audioChildren))

    local qx = g.quality.x + (compact and 3 or 2)
    local qw = g.quality.width - (compact and 6 or 4)
    local qChildren: {UiNode} = {
        smallLabel("quality/heading","02  DISPLAY / 畫質",qx,compact and 36.2 or 53,qw),
        ui.combobox({id="quality/choice",text=quality..(expanded and "   −" or "   +"),
            action="ToggleQuality",expanded=expanded,rect=g.combo,
            style={text_align="start",font_size=compact and 1.8 or 2.05}}),
    }
    if expanded then
        local choices = {"Eco","Balanced","Studio"}
        local gap = compact and 1.5 or 0.8
        local width = (qw-2*gap)/3
        for i, choice in ipairs(choices) do
            table.insert(qChildren,ui.button({id="quality/option/"..choice,text=choice,
                action="Quality_"..choice,
                rect=stageRect(qx+(i-1)*(width+gap),compact and 46.1 or 67,width,compact and 4.2 or 5),
                style={font_size=compact and 1.5 or 1.6,
                    background=choice == quality and palette.mint or palette.inset,
                    color=choice == quality and palette.paper or palette.ink}}))
        end
    else
        table.insert(qChildren,label("quality/help",compact and "Choose a profile / 選擇顯示模式"
            or "Open to choose Eco, Balanced or Studio.",
            stageRect(qx,compact and 46.5 or 68,qw,3.8),
            {font_size=compact and 1.45 or 1.55,color=palette.muted}))
    end
    table.insert(root,card("quality","harbor.display_settings",g.quality,qChildren))

    local lx = g.library.x + (compact and 3 or 2)
    local lw = g.library.width - (compact and 6 or 4)
    local selectedSnapshot = selectedKey
    local rowHeight = compact and 4.9 or 5.3
    local listOptions: UiVirtualOptions<PresetRow> = {
        id="presets/list",viewport=g.list,items=rows,
        key=function(item, _index): string return item.key end,
        rowHeight=rowHeight,gapY=0.6,resetKey="all-presets",inertia=true,deceleration=8,
        renderItem=function(item, _index, key): {UiNode}
            local isSelected = key == selectedSnapshot
            return {ui.button({id="preset/"..key,text=item.label,action="SelectPreset_"..key,
                rect={x=0,y=0,width=g.list.width,height=rowHeight},
                style={font_size=compact and 1.65 or 1.75,text_align="start",font_weight=isSelected and 700 or 400,
                    background=isSelected and palette.mint or palette.inset,
                    color=isSelected and palette.paper or palette.ink,
                    border_color=isSelected and palette.mint or palette.border}})}
        end,
    }
    local liveList: UiScrollNode = ui.virtualList(listOptions)
    local libraryChildren: {UiNode} = {
        smallLabel("presets/heading","03  PRESETS / 預設集",lx,compact and 55.3 or 27,lw),
        label("presets/title",compact and "120 spaces to make your own" or "Automation library  /  120 presets",
            stageRect(lx,compact and 58.1 or 31.3,lw,compact and 2.4 or 3.4),
            {font_size=compact and 1.45 or 2.15,font_weight=compact and 400 or 600,
                color=compact and palette.muted or palette.ink}),
        liveList,
        label("presets/selection","Selected: "..selectedLabel(),
            stageRect(lx,compact and 75.5 or 63,lw,2.4),
            {font_size=compact and 1.45 or 1.5,color=palette.muted,overflow="ellipsis"}),
    }
    table.insert(root,card("presets","harbor.preset_library",g.library,libraryChildren))

    local px = g.probe.x + (compact and 3 or 2)
    local pw = g.probe.width - (compact and 6 or 4)
    local probeChildren: {UiNode} = {
        smallLabel("probe/heading","04  INPUT LAB / 輸入測試",px,compact and 81.7 or 72,pw),
        ui.button({id="probe/hold",text=held and "Holding..." or "Hold to test",action="ProbeHold",
            rect=g.probeButton,style={font_size=compact and 1.45 or 1.6,
                background=held and palette.mint or palette.inset,
                color=held and palette.paper or palette.ink}}),
        label("probe/counts","Press "..tostring(presses).."   /   Release "..tostring(releases),
            stageRect(compact and 39 or px+15,compact and 85.0 or 79.4,
                compact and 53 or pw-15,2.5),{font_size=compact and 1.55 or 1.8,font_weight=600}),
        label("probe/state",(held and "HELD" or "RELEASED").." · "..(mismatches == 0 and "readers agree" or "MISMATCH"),
            stageRect(compact and 39 or px+15,compact and 87.7 or 83.2,
                compact and 53 or pw-15,2.1),
            {font_size=compact and 1.45 or 1.3,letter_spacing=0.03,color=palette.mint}),
    }
    if not compact then
        table.insert(probeChildren,label("probe/help","Press, hold, release. Two readers see every edge.",
            stageRect(px,75.5,pw,2.5),{font_size=1.4,color=palette.muted}))
    end
    table.insert(root,card("probe","harbor.input_probe",g.probe,probeChildren))
    local dirty = volume ~= appliedVolume or quality ~= appliedQuality or selectedKey ~= appliedPreset
    table.insert(root,ui.button({id="settings/apply",text=applyCount > 0 and not dirty
        and "Saved / 已套用" or "Apply settings / 套用",action="ApplySettings",rect=g.apply,
        style={font_size=compact and 1.7 or 1.9,background=palette.mint,color=palette.paper,
            border_color=palette.mint,font_weight=700}}))
    table.insert(root,ui.button({id="settings/reset",text="Reset / 重設",action="ResetSettings",rect=g.reset,
        style={font_size=compact and 1.6 or 1.7,color=palette.muted}}))
    if not compact then
        table.insert(root,label("settings/footer","YOUR SPACE. YOUR PACE.",stageRect(margin,93,88,2.8),
            {font_size=1.15,font_weight=600,letter_spacing=0.22,color=palette.muted}))
    end
    api.ui.setRoot(ui.screen({id="harbor-settings",node="settings",children=root}))
    api.observation.set("settings",{volume=volume,quality=quality,preset=selectedKey,
        preset_label=selectedLabel(),expanded=expanded,dirty=dirty,
        apply_count=applyCount,reset_count=resetCount,applied_volume=appliedVolume,
        applied_quality=appliedQuality,applied_preset=appliedPreset})
    api.observation.set("input_probe",{presses=presses,releases=releases,held=held,
        hold_ticks=holdTicks,total_held_ticks=totalHeldTicks,reader_a_presses=readerAPresses,
        reader_b_presses=readerBPresses,reader_a_releases=readerAReleases,
        reader_b_releases=readerBReleases,mismatches=mismatches,
        last_press_a=pressA,last_press_b=pressB,last_release_a=releaseA,last_release_b=releaseB})
    api.observation.set("layout",{name=g.name,aspect=aspect,compact=compact,
        slider=g.slider,slider_track=g.sliderTrack,combobox=g.combo,list=g.list,probe=g.probeButton,apply=g.apply,reset=g.reset})
    api.observation.set("preset_count",#rows)
    -- Read-only delivery evidence; no screen-pointer mapping or capture logic.
    api.observation.set("ui_input",{world_pointer_down=api.input.isPointerDown()})
    api.observation.set("tick",tick)
end

