function Game.update(api: EngineApi, _dt: number)
    tick += 1
    -- Independent read sites deliberately exercise non-consuming input queries.
    pressA = api.input.wasPressed("ProbeHold")
    releaseA = api.input.wasReleased("ProbeHold")
    local heldA = api.input.isDown("ProbeHold")
    pressB = api.input.wasPressed("ProbeHold")
    releaseB = api.input.wasReleased("ProbeHold")
    local heldB = api.input.isDown("ProbeHold")
    if pressA then readerAPresses += 1; presses += 1 end
    if pressB then readerBPresses += 1 end
    if releaseA then readerAReleases += 1; releases += 1 end
    if releaseB then readerBReleases += 1 end
    if pressA ~= pressB or releaseA ~= releaseB or heldA ~= heldB then mismatches += 1 end
    held = heldA
    if held then holdTicks += 1; totalHeldTicks += 1 else holdTicks = 0 end

    if api.input.wasPressed("ToggleQuality") then expanded = not expanded end
    for _, option in ipairs({"Eco","Balanced","Studio"}) do
        if api.input.wasPressed("Quality_"..option) then quality = option; expanded = false end
    end
    for _, row in ipairs(rows) do
        if api.input.wasPressed("SelectPreset_"..row.key) then selectedKey = row.key end
    end
    local level = volumeControl
    assert(level, "Volume control must be created in Game.start")
    local sliderChange = level.update(api.input)
    volume = sliderChange.value
    api.observation.set("slider",{value=sliderChange.value,changed=sliderChange.changed,
        dragging=sliderChange.dragging,started=sliderChange.started,
        released=sliderChange.released,cancelled=sliderChange.cancelled})
    if api.input.wasPressed("ApplySettings") then
        appliedVolume = volume; appliedQuality = quality; appliedPreset = selectedKey
        applyCount += 1
    end
    if api.input.wasPressed("ResetSettings") then
        volume = 72; quality = "Balanced"; selectedKey = "morning-calm"; expanded = false
        level.setValue(volume)
        resetCount += 1
    end
    publish(api)
end

return Game

