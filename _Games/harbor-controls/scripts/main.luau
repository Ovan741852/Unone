}
for _, space in ipairs(spaces) do
    for _, mood in ipairs(moods) do
        table.insert(rows, {key=space.key.."-"..mood.key,
            label=space.name.." / "..mood.name, category="Workspace preset"})
    end
end

local volume = 72
local quality = "Balanced"
local selectedKey = "morning-calm"
local expanded = false
local appliedVolume = 72
local appliedQuality = "Balanced"
local appliedPreset = "morning-calm"
local applyCount = 0
local resetCount = 0
local presses = 0
local releases = 0
local readerAPresses = 0
local readerBPresses = 0
local readerAReleases = 0
local readerBReleases = 0
local mismatches = 0
local held = false
local holdTicks = 0
local totalHeldTicks = 0
local tick = 0
local volumeControl: UiSliderControl? = nil
local responsiveLayout: UiResponsiveLayout<LayoutValues>? = nil
local pressA = false
local pressB = false
local releaseA = false
local releaseB = false

local palette = {
    ink={0.91,0.94,0.93,1}, muted={0.57,0.65,0.66,1},
    mint={0.63,0.88,0.76,1}, paper={0.061,0.092,0.105,1},
    border={0.16,0.23,0.25,1}, inset={0.085,0.133,0.148,1},
}
local textBase: UiStyle = {
    font_family="Segoe UI, Microsoft JhengHei, sans-serif", font_size=1.8,
    font_weight=400, line_height=1.3, letter_spacing=0,
    color=palette.ink, text_align="start", vertical_align="middle",
    wrap="none", overflow="clip",
}
local buttonBase: UiStyle = {
    font_family="Segoe UI, Microsoft JhengHei, sans-serif", font_size=1.7,
    font_weight=600, letter_spacing=0.02, line_height=1.2,
    color=palette.ink, background=palette.inset, border_color=palette.border,
    border_width=0.1, border_radius=0.65, padding={left=1.4,right=1.4},
    text_align="center", vertical_align="middle", wrap="none", overflow="clip",
}
local panelBase: UiStyle = {
    background=palette.paper, border_color=palette.border,
    border_width=0.1, border_radius=1.2,
}

-- This only converts an explicitly authored top-left stage rectangle to the
-- public y-up stage contract. It performs no arrangement, reflow or sizing.
local function stageRect(left: number, top: number, width: number, height: number): UiRect
    return {x=left,y=100-top-height,width=width,height=height}
end

local function selectedLabel(): string
    for _, row in ipairs(rows) do
        if row.key == selectedKey then return row.label end
    end
    return "No preset selected"
end

local function publish(api: EngineApi)
    local aspect = api.ui.getViewport().aspect
    local model = responsiveLayout
    assert(model, "Responsive layout must be created in Game.start")
    local resolved = model.resolve(api.ui.getViewport())
    local values = resolved.values
    local g: Geometry = {
        name=resolved.variant, compact=values.compact,
        audio=resolved.rect("audio"),quality=resolved.rect("quality"),
        library=resolved.rect("library"),probe=resolved.rect("probe"),
        apply=resolved.rect("apply"),reset=resolved.rect("reset"),
        slider=values.slider,sliderTrack=values.sliderTrack,combo=values.combo,
        probeButton=values.probeButton,list=values.list,
    }
    local compact = g.compact
    local ui: UiComponentKit = api.ui.components.create({
        text=textBase, button=buttonBase, slider=buttonBase,
        combobox=buttonBase, panel=panelBase,
    })
    local level = volumeControl
    assert(level, "Volume control must be created in Game.start")
    local function label(id: string, text: string, r: UiRect, style: UiStyle?): UiTextNode
        return ui.text({id=id,text=text,rect=r,style=style})
    end
    local function smallLabel(id: string, text: string, left: number, top: number, width: number): UiTextNode
        return label(id,text,stageRect(left,top,width,2.6),
            {font_size=compact and 1.45 or 1.35,font_weight=700,
             letter_spacing=0.17,color=palette.mint})
    end
    local function card(id: string, name: string, r: UiRect, children: {UiNode}): UiComponentNode
        return ui.component({id=id,component=name,rect=r,
            surface={kind="panel"},children=children})
    end

    local root: {UiNode} = {
        ui.panel({id="settings/background",rect=stageRect(0,0,100,100),
            background_for={screen=true},style={background={0.025,0.046,0.058,1},
                border_width=0,border_radius=0}}),
    }
    local margin = compact and 5 or (g.name == "medium" and 5 or 6)
    table.insert(root,label("settings/eyebrow","HARBOR  /  PREFERENCES",
        stageRect(margin,compact and 3.5 or 5,90,2.5),
        {font_size=compact and 1.45 or 1.35,font_weight=700,letter_spacing=0.25,
            color=palette.mint}))
    table.insert(root,label("settings/title","Make it yours.",
        stageRect(margin,compact and 7.2 or 9.1,90,compact and 5.5 or 7),
        {font_size=compact and 3.8 or 5.2,font_weight=700,letter_spacing=-0.08}))
    table.insert(root,label("settings/subtitle",compact and "工作空間設定 · A little more you."
        or "工作空間設定  /  A calmer space, tuned to the way you work.",
        stageRect(margin,compact and 14 or 18,90,3),
        {font_size=compact and 1.55 or 1.8,color=palette.muted}))

    local ax = g.audio.x + (compact and 3 or 2)
    local aw = g.audio.width - (compact and 6 or 4)
    local audioTop = compact and 19 or 25
    local audioChildren: {UiNode} = {
        smallLabel("audio/heading","01  AUDIO / 聲音",ax,audioTop+(compact and 1.1 or 2),aw),
        label("audio/label","Master level",stageRect(ax,compact and 24 or 31.5,aw*0.68,3.2),
            {font_size=compact and 1.85 or 2.2,font_weight=600}),
        label("audio/value",tostring(volume).."%",
            stageRect(ax+aw*0.7,compact and 24 or 31.5,aw*0.3,3.2),
            {font_size=compact and 2.1 or 2.7,font_weight=700,text_align="end",color=palette.mint}),
        level.view({text="Drag to adjust / 拖曳調整",action="AdjustLevel",
            rect=g.slider,trackRect=g.sliderTrack,style={font_size=compact and 1.55 or 1.7,
                text_align="start",color=palette.muted}}),
    }
    -- The visible track and its drag mapping share one authored rectangle.
    local track = g.sliderTrack
    local fillWidth = track.width * volume / 100
    if fillWidth > 0 then
        table.insert(audioChildren,ui.panel({id="audio/fill",rect={x=track.x,y=track.y,width=fillWidth,height=track.height},
            style={background=palette.mint,border_width=0,border_radius=0.1}}))
